#!/usr/bin/env bash
# dev – start the Linklater development servers

set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
ROOT_DIR=$(cd -- "$SCRIPT_DIR/.." && pwd)
cd "$ROOT_DIR" || exit

# shellcheck source=lib/cli.sh disable=SC1091
. "$SCRIPT_DIR/lib/cli.sh" 2>/dev/null ||
  { printf 'Cannot load %s/lib/cli.sh\n' "$SCRIPT_DIR" >&2; exit 70; }

# ── Arguments ────────────────────────────────────────────────────────────────
usage() {
  cat <<'USAGE'
Usage: bin/dev [options]

Starts the API and web development servers with a live status/log view.
Runs npm run dev instead when that view cannot be shown or you turn it off.

Examples:
  bin/dev            Start the development servers
  bin/dev --remote   Start them and expose them on the Wi-Fi network
  bin/dev --public   Start them and expose them through a Cloudflare tunnel

Options:
  --remote     Allows the app to be reachable from other devices on the same
               Wi-Fi network. Prints the LAN URL in the status view.
  --public     Allows the app to be reachable publicly using a Cloudflare
               TryCloudflare tunnel. Prints the tunnel URL in the status view.
  --no-input   Run npm run dev instead of the interactive status view.
  --no-color   Disable colored output.
  --version    Print the version and exit.
  -h, --help   Show this help.

Keys:
  0  Status
  1  API logs
  2  Web logs
  3  Mailpit logs (when installed)
  4  Tunnel logs (--public only)
  u  Scroll up in a log view
  d  Scroll down in a log view
  q  Quit

Control+C quits as well. Pressing it again while the servers are stopping
stops them immediately.

Logs from each run are kept in a folder under the system temp directory.
The path is printed when the servers stop, and the five newest runs are
kept.

See README.md for setup and usage notes.
USAGE
}

scan_help "$@"

REMOTE=false
PUBLIC=false
NO_INPUT=false
USE_COLOR=true

for argument in "$@"; do
  case "$argument" in
    --remote)
      REMOTE=true
      ;;
    --public)
      PUBLIC=true
      REMOTE=true
      ;;
    --no-input)
      NO_INPUT=true
      ;;
    --no-color)
      USE_COLOR=false
      ;;
    --version)
      print_version
      ;;
    *)
      unknown_flag "$argument"
      ;;
  esac
done

probe_terminal

if [[ "$NO_INPUT" == true || "$TTY_AVAILABLE" != true || "${TERM:-dumb}" == "dumb" ]]; then
  if [[ "$NO_INPUT" == true ]]; then
    printf 'Not starting the status view: --no-input was passed.\n' >&2
  elif [[ ! -t 1 ]]; then
    printf 'Not starting the status view: output is being redirected.\n' >&2
  elif [[ "${TERM:-dumb}" == "dumb" ]]; then
    printf 'Not starting the status view: TERM is dumb or unset.\n' >&2
  else
    printf 'Not starting the status view: no controlling terminal is available.\n' >&2
  fi
  printf 'Running npm run dev, which starts the API and web servers only.\n' >&2
  printf 'Skipped: the stale port check and Mailpit.\n' >&2
  if [[ "$PUBLIC" == true ]]; then
    printf 'Skipped: --public, so no Cloudflare tunnel and no access from other devices.\n' >&2
  elif [[ "$REMOTE" == true ]]; then
    printf 'Skipped: --remote, so no access from other devices.\n' >&2
  fi
  if [[ "$USE_COLOR" == false ]]; then
    export NO_COLOR=1
  fi
  exec npm run dev
fi

# ── Colors & symbols ─────────────────────────────────────────────────────────
resolve_color "$USE_COLOR"

SPIN=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
TICK=✓  CROSS=✗  CIRCLE=○
SAVE_CURSOR=$'\e7'  RESTORE_CURSOR=$'\e8'

# ── Mailpit binary detection ──────────────────────────────────────────────────
MAILPIT_BIN=""
if command -v mailpit &>/dev/null; then
  MAILPIT_BIN=$(command -v mailpit)
elif [[ -x /opt/homebrew/opt/mailpit/bin/mailpit ]]; then
  MAILPIT_BIN=/opt/homebrew/opt/mailpit/bin/mailpit
elif [[ -x /usr/local/opt/mailpit/bin/mailpit ]]; then
  MAILPIT_BIN=/usr/local/opt/mailpit/bin/mailpit
fi

# ── cloudflared binary detection (public mode) ────────────────────────────────
CLOUDFLARED_BIN=""
if [[ "$PUBLIC" == true ]]; then
  if command -v cloudflared &>/dev/null; then
    CLOUDFLARED_BIN=$(command -v cloudflared)
  elif [[ -x /opt/homebrew/opt/cloudflared/bin/cloudflared ]]; then
    CLOUDFLARED_BIN=/opt/homebrew/opt/cloudflared/bin/cloudflared
  elif [[ -x /usr/local/opt/cloudflared/bin/cloudflared ]]; then
    CLOUDFLARED_BIN=/usr/local/opt/cloudflared/bin/cloudflared
  fi
fi

# ── Log files ─────────────────────────────────────────────────────────────────
TEMP_ROOT="${TMPDIR:-/tmp}"
LOG_ROOT="${TEMP_ROOT%/}/linklater-dev"
LOG_RUNS_KEPT=5
LOG_DIR="$LOG_ROOT/$(date +%Y%m%d-%H%M%S)-$$"
if ! mkdir -p "$LOG_DIR" 2>/dev/null; then
  printf 'Cannot create the log folder %s\n' "$LOG_DIR" >&2
  exit 73
fi
chmod 700 "$LOG_DIR"

API_LOG="$LOG_DIR/api.log"
WEB_LOG="$LOG_DIR/web.log"
MAILPIT_LOG="$LOG_DIR/mailpit.log"
TUNNEL_LOG="$LOG_DIR/tunnel.log"
touch "$API_LOG" "$WEB_LOG" "$MAILPIT_LOG" "$TUNNEL_LOG"
KEY_FILE=$(mktemp)

prune_run_logs() {
  local runs total excess entry
  runs=$(find "$LOG_ROOT" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort)
  [[ -z "$runs" ]] && return
  total=$(printf '%s\n' "$runs" | wc -l)
  excess=$(( total - LOG_RUNS_KEPT ))
  (( excess < 1 )) && return
  printf '%s\n' "$runs" | head -n "$excess" | while IFS= read -r entry; do
    rm -f "$entry"/*.log
    rmdir "$entry" 2>/dev/null || true
  done
}
prune_run_logs

# ── Process state ─────────────────────────────────────────────────────────────
# Values: starting | ready | error | skipped | "" (blank)
API_STATE="starting"
WEB_STATE="starting"
MAILPIT_STATE="starting"
TUNNEL_STATE=""
API_URL=""
WEB_URL=""
MAILPIT_URL=""
TUNNEL_URL=""
API_PID=""
WEB_PID=""
MAILPIT_PID=""
TUNNEL_PID=""
KEY_READER_PID=""

if [[ "$PUBLIC" == true ]]; then
  if [[ -n "$CLOUDFLARED_BIN" ]]; then
    TUNNEL_STATE="starting"
  else
    TUNNEL_STATE="skipped"
  fi
fi

# ── LAN hostname (remote mode) ────────────────────────────────────────────────
REMOTE_URL=""
LAN_HOSTNAME=""
if [[ "$REMOTE" == true ]]; then
  LAN_HOSTNAME=$(scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null || true)
  if [[ -n "$LAN_HOSTNAME" ]]; then
    REMOTE_URL="https://${LAN_HOSTNAME}.local:5173"
  fi
fi

# ── View state ────────────────────────────────────────────────────────────────
# Values: status | api | web | mailpit | tunnel
VIEW="status"
FRAME=0

SCROLL_FOLLOWING=0
SCROLL_API=$SCROLL_FOLLOWING
SCROLL_WEB=$SCROLL_FOLLOWING
SCROLL_MAILPIT=$SCROLL_FOLLOWING
SCROLL_TUNNEL=$SCROLL_FOLLOWING

LOG_GROWTH_POLL_TICKS=3
LOG_GROWTH_TICKS=0
LOG_PAINTED_LINES=0

# ── Cleanup ───────────────────────────────────────────────────────────────────
OLD_STTY=$(stty -g </dev/tty)
CLEANUP_POLL_SECONDS=0.1
CLEANUP_POLL_LIMIT=50
CLEANUP_FEEDBACK_POLL=20
CLEANUP_ESCALATE=false
DESCENDANT_PIDS=""
STOP_ROUTE=""

hide_cursor() { printf '\033[?25l'; }
show_cursor()  { printf '\033[?25h'; }

any_service_failed() {
  [[ "$API_STATE" == "error" || "$WEB_STATE" == "error" || \
     "$MAILPIT_STATE" == "error" || "$TUNNEL_STATE" == "error" ]]
}

any_service_starting() {
  [[ "$API_STATE" == "starting" || "$WEB_STATE" == "starting" || \
     "$MAILPIT_STATE" == "starting" || "$TUNNEL_STATE" == "starting" ]]
}

_time_out_service() {
  local state_name=$1 log=$2 waited_for=$3 view=$4
  [[ "${!state_name}" != "starting" ]] && return
  printf 'Gave up after %s seconds waiting for: %s\n' \
    "$STARTING_TIMEOUT_SECONDS" "$waited_for" >>"$log"
  eval "$state_name=error"
  VIEW="$view"
}

_escalate() {
  CLEANUP_ESCALATE=true
}

_collect_descendants() {
  local pid child
  for pid in "$@"; do
    [[ -z "$pid" ]] && continue
    for child in $(pgrep -P "$pid" 2>/dev/null); do
      _collect_descendants "$child"
      DESCENDANT_PIDS="$DESCENDANT_PIDS $child"
    done
  done
}

_kill_children() {
  local signal=$1 pid
  for pid in $DESCENDANT_PIDS; do
    kill "$signal" "$pid" 2>/dev/null || true
  done
  for pid in "$KEY_READER_PID" "$API_PID" "$WEB_PID" "$MAILPIT_PID" "$TUNNEL_PID"; do
    if [[ -n "$pid" ]]; then
      kill "$signal" "$pid" 2>/dev/null || true
    fi
  done
}

_children_alive() {
  local pid
  for pid in $DESCENDANT_PIDS; do
    kill -0 "$pid" 2>/dev/null && return 0
  done
  for pid in "$KEY_READER_PID" "$API_PID" "$WEB_PID" "$MAILPIT_PID" "$TUNNEL_PID"; do
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
  done
  return 1
}

_await_children() {
  local polls=0
  while _children_alive; do
    # the sleep return misses a signal landing between polls, hence the flag
    [[ "$CLEANUP_ESCALATE" == true ]] && return 1
    (( polls >= CLEANUP_POLL_LIMIT )) && return 1
    sleep "$CLEANUP_POLL_SECONDS" || return 1
    polls=$(( polls + 1 ))
    (( polls == CLEANUP_FEEDBACK_POLL )) && printf '  Still stopping the services.\n' >&2
  done
  return 0
}

_quit() {
  local status=$1
  any_service_failed && status=1
  rm -f "$KEY_FILE"
  stty "$OLD_STTY" </dev/tty 2>/dev/null || true
  show_cursor
  printf '\n'
  printf '  Logs: %s\n' "$LOG_DIR" >&2
  exit "$status"
}

_cleanup() {
  local route=$1 status=$2
  trap '' EXIT
  trap '_escalate' INT QUIT TERM HUP
  if [[ "$route" == interrupt ]]; then
    printf '\n  Stopping services. Press Control+C again to stop them immediately.\n' >&2
  else
    printf '\n  Stopping services. Press Control+C to stop them immediately.\n' >&2
  fi
  # snapshot first: a reparented grandchild is invisible to pgrep -P
  _collect_descendants "$KEY_READER_PID" "$API_PID" "$WEB_PID" "$MAILPIT_PID" "$TUNNEL_PID"
  _kill_children -TERM
  _await_children || _kill_children -KILL
  _quit "$status"
}
trap '_cleanup quit $?' EXIT
# the loop calls _cleanup: bash defers a signal while its own handler runs
trap 'STOP_ROUTE=interrupt' INT
trap 'STOP_ROUTE=signal' TERM HUP QUIT

# ── Terminal setup ────────────────────────────────────────────────────────────
stty -echo -icanon </dev/tty

# ── Background key reader ─────────────────────────────────────────────────────
(
  while true; do
    char=''
    IFS= read -r -n 1 char </dev/tty 2>/dev/null || break
    [[ -n "$char" ]] && printf '%s' "$char" >> "$KEY_FILE"
  done
) &
KEY_READER_PID=$!

# ── Strip ANSI escape codes (BSD sed compatible) ──────────────────────────────
strip_ansi() {
  LC_ALL=C sed -e $'s/\033\\[[0-9;:<=>?]*[@-~]//g' \
               -e $'s/\033][^\033\007]*\007//g' \
               -e $'s/\033][^\033\007]*\033\\\\//g'
}

# ── Static header (lines 1–4, never redrawn) ─────────────────────────────────
draw_header() {
  printf '\033[2J\033[H'
  printf '  %s%s╔═════════════════╗%s\n' "$BOLD" "$CYAN" "$RESET"
  printf '  %s%s║    Linklater    ║%s\n' "$BOLD" "$CYAN" "$RESET"
  printf '  %s%s╚═════════════════╝%s\n' "$BOLD" "$CYAN" "$RESET"
  printf '\n'
}

# ── Service row ───────────────────────────────────────────────────────────────
render_service_line() {
  local state=$1 url=$2 frame_char=$3 label=$4
  case "$state" in
    starting) printf "${YELLOW}%s${RESET} %-7s  starting"                 "$frame_char" "$label" ;;
    ready)    printf "${GREEN}%s${RESET} %-7s  ${GREEN}ready  %s${RESET}" "$TICK"       "$label" "$url" ;;
    error)    printf "${RED}%s${RESET} %-7s  ${RED}error${RESET}"         "$CROSS"      "$label" ;;
    skipped)  printf "%s %-7s  not installed"                             "$CIRCLE"     "$label" ;;
  esac
}

# ── LAN row (remote mode only) ────────────────────────────────────────────────
render_lan_line() {
  [[ -z "$REMOTE_URL" ]] && return
  printf "${CYAN}↗${RESET} %-7s  ${CYAN}%s${RESET}" "LAN" "$REMOTE_URL"
}

# ── Tunnel row (public mode only) ─────────────────────────────────────────────
render_tunnel_line() {
  render_service_line "$TUNNEL_STATE" "$TUNNEL_URL" "$1" "Tunnel"
}

# ── Key list ──────────────────────────────────────────────────────────────────
render_key_list() {
  local current=$1
  local out=''
  if [[ "$current" == "API" ]]; then
    out+="  1. API logs (current)"$'\n'
  else
    out+="  1. API logs"$'\n'
  fi
  if [[ "$current" == "Web" ]]; then
    out+="  2. Web logs (current)"$'\n'
  else
    out+="  2. Web logs"$'\n'
  fi
  if [[ "$MAILPIT_STATE" != "skipped" ]]; then
    if [[ "$current" == "Mailpit" ]]; then
      out+="  3. Mailpit logs (current)"$'\n'
    else
      out+="  3. Mailpit logs"$'\n'
    fi
  fi
  if [[ -n "$TUNNEL_STATE" && "$TUNNEL_STATE" != "skipped" ]]; then
    if [[ "$current" == "Tunnel" ]]; then
      out+="  4. Tunnel logs (current)"$'\n'
    else
      out+="  4. Tunnel logs"$'\n'
    fi
  fi
  if [[ -n "$current" ]]; then
    out+="  u. Scroll up"$'\n'
    out+="  d. Scroll down"$'\n'
  fi
  printf '%s' "$out"
}

# ── Status view ───────────────────────────────────────────────────────────────
render_status_view() {
  local frame_char=$1
  local out=''
  out+=$'\033[5;1H\033[0J'
  out+="  Viewing: status"$'\n'$'\n'

  out+="  $(render_service_line "$API_STATE" "$API_URL" "$frame_char" "API")"$'\n'
  out+="  $(render_service_line "$WEB_STATE" "$WEB_URL" "$frame_char" "Web")"$'\n'
  out+="  $(render_service_line "$MAILPIT_STATE" "$MAILPIT_URL" "$frame_char" "Mailpit")"$'\n'
  if [[ -n "$TUNNEL_STATE" ]]; then
    out+="  $(render_tunnel_line "$frame_char")"$'\n'
  fi
  if [[ -n "$REMOTE_URL" ]]; then
    out+="  $(render_lan_line)"$'\n'
  fi
  out+=$'\n'

  if [[ "$API_STATE" == "ready" && "$WEB_STATE" == "ready" && \
        ("$MAILPIT_STATE" == "ready" || "$MAILPIT_STATE" == "skipped") && \
        ("$TUNNEL_STATE" == "" || "$TUNNEL_STATE" == "ready" || "$TUNNEL_STATE" == "skipped") ]]; then
    out+="  ${GREEN}${BOLD}Ready.${RESET}"$'\n'$'\n'
  elif any_service_failed; then
    out+="  ${RED}${BOLD}An error occurred.${RESET}"$'\n'$'\n'
  else
    out+="  Starting up…"$'\n'$'\n'
  fi

  out+="$(render_key_list '')"$'\n'$'\n'
  out+="  Press q or Control+C to stop"

  printf '%s' "$out"
}

# ── Spinner cells ─────────────────────────────────────────────────────────────
render_spinner_cells() {
  local frame_char=$1
  local out=''
  # rows 7-10 are the service block both views draw after the row 5 address
  [[ "$API_STATE" == "starting" ]]     && out+=$'\033[7;3H'"${YELLOW}${frame_char}${RESET}"
  [[ "$WEB_STATE" == "starting" ]]     && out+=$'\033[8;3H'"${YELLOW}${frame_char}${RESET}"
  [[ "$MAILPIT_STATE" == "starting" ]] && out+=$'\033[9;3H'"${YELLOW}${frame_char}${RESET}"
  [[ "$TUNNEL_STATE" == "starting" ]]  && out+=$'\033[10;3H'"${YELLOW}${frame_char}${RESET}"
  [[ -n "$out" ]] && printf '%s%s%s' "$SAVE_CURSOR" "$out" "$RESTORE_CURSOR"
}

# ── Log view geometry ─────────────────────────────────────────────────────────
compute_log_geometry() {
  local stty_size; stty_size=$(stty size 2>/dev/null </dev/tty)
  local rows; rows=${stty_size%% *}; rows=${rows:-24}
  local cols; cols=${stty_size##* }; cols=${cols:-80}
  CONTENT_WIDTH=$(( cols - 4 ))
  (( CONTENT_WIDTH < 20 )) && CONTENT_WIDTH=20
  if [[ "$MAILPIT_STATE" == "skipped" ]]; then
    AVAILABLE=$(( rows - 20 ))
  else
    AVAILABLE=$(( rows - 21 ))
  fi
  [[ -n "$REMOTE_URL" ]] && AVAILABLE=$(( AVAILABLE - 1 ))
  [[ -n "$TUNNEL_STATE" ]] && AVAILABLE=$(( AVAILABLE - 1 ))
  [[ -n "$TUNNEL_STATE" && "$TUNNEL_STATE" != "skipped" ]] && AVAILABLE=$(( AVAILABLE - 1 ))
  (( AVAILABLE < 1 )) && AVAILABLE=1
}

# ── Current view ──────────────────────────────────────────────────────────────
view_log_file() {
  case "$VIEW" in
    api)     printf '%s' "$API_LOG" ;;
    web)     printf '%s' "$WEB_LOG" ;;
    mailpit) printf '%s' "$MAILPIT_LOG" ;;
    tunnel)  printf '%s' "$TUNNEL_LOG" ;;
  esac
}

view_service_state() {
  case "$VIEW" in
    api)     printf '%s' "$API_STATE" ;;
    web)     printf '%s' "$WEB_STATE" ;;
    mailpit) printf '%s' "$MAILPIT_STATE" ;;
    tunnel)  printf '%s' "$TUNNEL_STATE" ;;
  esac
}

view_scroll() {
  case "$VIEW" in
    api)     printf '%s' "$SCROLL_API" ;;
    web)     printf '%s' "$SCROLL_WEB" ;;
    mailpit) printf '%s' "$SCROLL_MAILPIT" ;;
    tunnel)  printf '%s' "$SCROLL_TUNNEL" ;;
    *)       printf '%s' "$SCROLL_FOLLOWING" ;;
  esac
}

set_view_scroll() {
  case "$VIEW" in
    api)     SCROLL_API=$1 ;;
    web)     SCROLL_WEB=$1 ;;
    mailpit) SCROLL_MAILPIT=$1 ;;
    tunnel)  SCROLL_TUNNEL=$1 ;;
  esac
}

# ── Log window ────────────────────────────────────────────────────────────────
log_line_total() {
  local total; total=$(awk 'END { print NR }' "$1" 2>/dev/null)
  printf '%s' "${total:-0}"
}

log_follow_start() {
  local log_file=$1 service_state=$2 total=$3
  local start=$(( total - AVAILABLE + 1 )) error_line
  if [[ "$service_state" == "error" ]]; then
    # Start from 2 lines before the first error so the full message is visible
    error_line=$(grep -n 'Error\|EADDR\|EACCES\|UnhandledPromise\|Cannot find module' \
                 "$log_file" 2>/dev/null | head -1 | cut -d: -f1)
    if [[ -n "$error_line" && "$error_line" -gt 2 ]]; then
      start=$(( error_line - 2 ))
    fi
  fi
  (( start < 1 )) && start=1
  printf '%s' "$start"
}

log_window_start() {
  local log_file=$1 total=$2
  local start; start=$(view_scroll)
  if (( start == SCROLL_FOLLOWING )); then
    start=$(log_follow_start "$log_file" "$(view_service_state)" "$total")
  fi
  printf '%s' "$start"
}

scroll_log_view() {
  local direction=$1 log_file total start bottom
  log_file=$(view_log_file)
  [[ -z "$log_file" ]] && return
  compute_log_geometry
  total=$(log_line_total "$log_file")
  start=$(log_window_start "$log_file" "$total")
  bottom=$(( total - AVAILABLE + 1 ))
  (( bottom < 1 )) && bottom=1
  if [[ "$direction" == up ]]; then
    start=$(( start - AVAILABLE ))
    (( start < 1 )) && start=1
    set_view_scroll "$start"
  elif (( start + AVAILABLE >= bottom )); then
    set_view_scroll "$SCROLL_FOLLOWING"
  else
    set_view_scroll "$(( start + AVAILABLE ))"
  fi
}

render_log_position() {
  local start=$1 last=$2 total=$3 edge=''
  if (( total < 1 )); then
    printf 'no output yet'
    return
  fi
  if (( start <= 1 && last >= total )); then
    edge=', all'
  elif (( start <= 1 )); then
    edge=', top'
  elif (( last >= total )); then
    edge=', end'
  fi
  printf 'lines %s-%s of %s%s' "$start" "$last" "$total" "$edge"
}

# ── Log view ──────────────────────────────────────────────────────────────────
render_log_view() {
  local frame_char=$1 label=$2 log_file=$3
  compute_log_geometry
  local divider; printf -v divider '%*s' "$CONTENT_WIDTH" ''
  divider=${divider// /─}

  local out=''
  out+=$'\033[5;1H\033[0J'
  out+="  Viewing: ${label} logs"$'\n'$'\n'

  out+="  $(render_service_line "$API_STATE" "$API_URL" "$frame_char" "API")"$'\n'
  out+="  $(render_service_line "$WEB_STATE" "$WEB_URL" "$frame_char" "Web")"$'\n'
  out+="  $(render_service_line "$MAILPIT_STATE" "$MAILPIT_URL" "$frame_char" "Mailpit")"$'\n'
  if [[ -n "$TUNNEL_STATE" ]]; then
    out+="  $(render_tunnel_line "$frame_char")"$'\n'
  fi
  if [[ -n "$REMOTE_URL" ]]; then
    out+="  $(render_lan_line)"$'\n'
  fi
  out+=$'\n'
  out+="  0. (back to status)"$'\n'$'\n'
  out+="$(render_key_list "$label")"$'\n'$'\n'

  local prefix_len=$(( ${#label} + 8 ))
  local divider_width=$(( CONTENT_WIDTH - prefix_len ))
  (( divider_width < 0 )) && divider_width=0
  out+="  ${DIM}── ${label} ${divider:0:$divider_width}${RESET}"$'\n'

  local total start last
  total=$(log_line_total "$log_file")
  LOG_PAINTED_LINES=$total
  start=$(log_window_start "$log_file" "$total")
  last=$(( start + AVAILABLE - 1 ))
  (( last > total )) && last=$total
  out+="  $(render_log_position "$start" "$last" "$total")"$'\n'

  if (( total > 0 )); then
    while IFS= read -r line; do
      out+="  ${line:0:$CONTENT_WIDTH}"$'\n'
    done < <(sed -n "${start},${last}p" "$log_file" 2>/dev/null | strip_ansi || true)
  fi

  printf '%s' "$out"
}

# ── Free stale port ──────────────────────────────────────────────────────────
# Kill any process holding the API port so a leftover Node from a previous run
# doesn't crash startup with EADDRINUSE.
free_port() {
  local port=$1 log=$2
  local pids
  pids=$(lsof -ti tcp:"$port" -sTCP:LISTEN 2>/dev/null || true)
  if [[ -n "$pids" ]]; then
    printf 'Freeing port %s (killing PID %s)\n' "$port" "$(echo "$pids" | tr '\n' ' ')" >>"$log"
    # shellcheck disable=SC2086
    kill -9 $pids 2>/dev/null || true
    # Brief pause to let the kernel release the socket before bind().
    sleep 0.2
  fi
}

# ── Launch services ───────────────────────────────────────────────────────────
launch_tunnel() {
  local port=$1
  printf 'Starting the tunnel to https://localhost:%s\n' "$port" >>"$TUNNEL_LOG"
  "$CLOUDFLARED_BIN" tunnel --no-tls-verify --url "https://localhost:$port" \
    </dev/null >>"$TUNNEL_LOG" 2>&1 &
  TUNNEL_PID=$!
  TUNNEL_LAUNCH_SECONDS=$SECONDS
}

hide_cursor
draw_header

API_PORT="${PORT:-3000}"
free_port "$API_PORT" "$API_LOG"

npm run dev --workspace @linklater/api </dev/null >>"$API_LOG" 2>&1 &
API_PID=$!

if [[ "$REMOTE" == true ]]; then
  VITE_API_BASE_URL=/api npm run dev --workspace @linklater/web -- --host </dev/null >"$WEB_LOG" 2>&1 &
else
  npm run dev --workspace @linklater/web </dev/null >"$WEB_LOG" 2>&1 &
fi
WEB_PID=$!

if [[ -n "$MAILPIT_BIN" ]]; then
  "$MAILPIT_BIN" </dev/null >"$MAILPIT_LOG" 2>&1 &
  MAILPIT_PID=$!
else
  MAILPIT_STATE="skipped"
fi

if [[ "$TUNNEL_STATE" == "starting" ]]; then
  printf 'Waiting for the web server before starting the tunnel.\n' >>"$TUNNEL_LOG"
fi

# ── Live update loop ──────────────────────────────────────────────────────────
DIRTY=true  # always draw on first tick
STARTING_TIMEOUT_SECONDS=90
LAUNCH_SECONDS=$SECONDS
TUNNEL_LAUNCH_SECONDS=0

while true; do
  PREV_API_STATE="$API_STATE"
  PREV_WEB_STATE="$WEB_STATE"
  PREV_MAILPIT_STATE="$MAILPIT_STATE"
  PREV_TUNNEL_STATE="$TUNNEL_STATE"
  PREV_VIEW="$VIEW"

  KEY_BATCH=''
  if [[ -s "$KEY_FILE" ]]; then
    KEY_BATCH=$(< "$KEY_FILE")
    : > "$KEY_FILE"
  fi

  PENDING_KEYS="$KEY_BATCH"
  while [[ -n "$PENDING_KEYS" ]]; do
    key="${PENDING_KEYS:0:1}"
    PENDING_KEYS="${PENDING_KEYS:1}"
    case "$key" in
      0) VIEW="status" ;;
      1) VIEW="api" ;;
      2) VIEW="web" ;;
      3) [[ "$MAILPIT_STATE" != "skipped" ]] && VIEW="mailpit" ;;
      4) [[ -n "$TUNNEL_STATE" && "$TUNNEL_STATE" != "skipped" ]] && VIEW="tunnel" ;;
      u) scroll_log_view up ;;
      d) scroll_log_view down ;;
      q) exit 0 ;;
    esac
  done

  [[ -n "$STOP_ROUTE" ]] && _cleanup "$STOP_ROUTE" 130

  # Detect ready signals
  if [[ "$API_STATE" == "starting" ]] && \
     grep -q "Nest application successfully started" "$API_LOG" 2>/dev/null; then
    LISTEN_PORT=$(grep -oE 'Listening on port [0-9]+' "$API_LOG" 2>/dev/null \
                  | grep -oE '[0-9]+$' | tail -1 || true)
    API_URL="https://localhost:${LISTEN_PORT:-$API_PORT}"
    API_STATE="ready"
  fi

  if [[ "$WEB_STATE" == "starting" ]]; then
    EXTRACTED=$(grep 'Local:' "$WEB_LOG" 2>/dev/null \
                | grep -oE 'https?://[^ ]+' | tail -1 || true)
    if [[ -n "$EXTRACTED" ]]; then
      WEB_URL="${EXTRACTED%/}"
      WEB_STATE="ready"
      WEB_PORT="${WEB_URL##*:}"
      [[ "$WEB_PORT" =~ ^[0-9]+$ ]] || WEB_PORT=5173
      [[ -n "$LAN_HOSTNAME" ]] && REMOTE_URL="https://${LAN_HOSTNAME}.local:${WEB_PORT}"
      [[ "$TUNNEL_STATE" == "starting" ]] && launch_tunnel "$WEB_PORT"
    fi
  fi

  if [[ "$MAILPIT_STATE" == "starting" ]] && \
     grep -q "starting on" "$MAILPIT_LOG" 2>/dev/null; then
    MAILPIT_URL="http://localhost:8025"
    MAILPIT_STATE="ready"
  fi

  if [[ "$TUNNEL_STATE" == "starting" ]]; then
    EXTRACTED=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' "$TUNNEL_LOG" 2>/dev/null \
                | head -1 || true)
    if [[ -n "$EXTRACTED" ]]; then
      TUNNEL_URL="$EXTRACTED"
      TUNNEL_STATE="ready"
    fi
  fi

  if any_service_starting && (( SECONDS - LAUNCH_SECONDS >= STARTING_TIMEOUT_SECONDS )); then
    _time_out_service API_STATE "$API_LOG" 'Nest application successfully started' api
    _time_out_service WEB_STATE "$WEB_LOG" 'the Vite Local: address' web
    _time_out_service MAILPIT_STATE "$MAILPIT_LOG" 'Mailpit starting on' mailpit
  fi

  if [[ -n "$TUNNEL_PID" ]] && \
     (( SECONDS - TUNNEL_LAUNCH_SECONDS >= STARTING_TIMEOUT_SECONDS )); then
    _time_out_service TUNNEL_STATE "$TUNNEL_LOG" 'a trycloudflare.com address' tunnel
  fi

  # Detect crashes – process death or fatal error in log
  if [[ "$API_STATE" != "error" ]]; then
    if ! kill -0 "$API_PID" 2>/dev/null || \
       grep -qE '(EADDRINUSE|EACCES|UnhandledPromiseRejection|Error:.*listen)' "$API_LOG" 2>/dev/null; then
      API_STATE="error"
      VIEW="api"
    fi
  fi
  if [[ "$WEB_STATE" != "error" ]]; then
    if ! kill -0 "$WEB_PID" 2>/dev/null || \
       grep -qE '(EADDRINUSE|EACCES|error when starting dev server)' "$WEB_LOG" 2>/dev/null; then
      WEB_STATE="error"
      VIEW="web"
    fi
  fi
  if [[ "$MAILPIT_STATE" != "error" && "$MAILPIT_STATE" != "skipped" ]]; then
    if ! kill -0 "$MAILPIT_PID" 2>/dev/null || \
       grep -qE '(EADDRINUSE|EACCES)' "$MAILPIT_LOG" 2>/dev/null; then
      MAILPIT_STATE="error"
      VIEW="mailpit"
    fi
  fi
  if [[ -n "$TUNNEL_PID" && "$TUNNEL_STATE" != "error" && "$TUNNEL_STATE" != "skipped" ]]; then
    if ! kill -0 "$TUNNEL_PID" 2>/dev/null; then
      TUNNEL_STATE="error"
      VIEW="tunnel"
    fi
  fi
  if [[ -z "$TUNNEL_PID" && "$TUNNEL_STATE" == "starting" && "$WEB_STATE" == "error" ]]; then
    printf 'Not starting the tunnel: the web server never became ready.\n' >>"$TUNNEL_LOG"
    TUNNEL_STATE="error"
  fi

  if [[ "$API_STATE"  != "$PREV_API_STATE"  || "$WEB_STATE"  != "$PREV_WEB_STATE"  || \
        "$MAILPIT_STATE" != "$PREV_MAILPIT_STATE" || "$TUNNEL_STATE" != "$PREV_TUNNEL_STATE" || \
        "$VIEW" != "$PREV_VIEW" || -n "$KEY_BATCH" ]]; then
    DIRTY=true
  fi

  if [[ "$VIEW" != "status" ]]; then
    LOG_GROWTH_TICKS=$(( LOG_GROWTH_TICKS + 1 ))
    if (( LOG_GROWTH_TICKS >= LOG_GROWTH_POLL_TICKS )); then
      LOG_GROWTH_TICKS=0
      if (( $(view_scroll) == SCROLL_FOLLOWING )) && \
         (( $(log_line_total "$(view_log_file)") > LOG_PAINTED_LINES )); then
        DIRTY=true
      fi
    fi
  fi

  # Redraw the region only when something changed, otherwise move the spinner
  if [[ "$DIRTY" == true ]] || any_service_starting; then
    frame_char="${SPIN[$((FRAME % ${#SPIN[@]}))]}"
    FRAME=$(( FRAME + 1 ))
    if [[ "$DIRTY" == true ]]; then
      DIRTY=false
      case "$VIEW" in
        status)  render_status_view "$frame_char" ;;
        api)     render_log_view "$frame_char" "API"  "$API_LOG"  ;;
        web)     render_log_view "$frame_char" "Web"  "$WEB_LOG"  ;;
        mailpit) render_log_view "$frame_char" "Mailpit" "$MAILPIT_LOG" ;;
        tunnel)  render_log_view "$frame_char" "Tunnel" "$TUNNEL_LOG" ;;
      esac
    else
      render_spinner_cells "$frame_char"
    fi
  fi

  sleep 0.08
done
