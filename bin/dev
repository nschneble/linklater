#!/usr/bin/env bash
# dev – start the Linklater development servers with a live status TUI

set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT_DIR=$(cd -- "$SCRIPT_DIR/.." && pwd)
cd "$ROOT_DIR" || exit

# ── Arguments ────────────────────────────────────────────────────────────────
usage() {
  cat <<'USAGE'
Usage: bin/dev [--remote]

Starts the API and web development servers with a live status/log TUI.

Options:
  --remote   Allow the app to be reachable from other devices on the same
             Wi-Fi network. Prints the LAN url in the status view.

Keys:
  0  Status
  1  API logs
  2  Web logs
  3  Mailpit logs (when installed)
USAGE
}

REMOTE=false

for arg in "$@"; do
  case "$arg" in
    -h|--help)
      usage
      exit 0
      ;;
    --remote)
      REMOTE=true
      ;;
    *)
      printf 'Unknown option: %s\n\n' "$arg" >&2
      usage >&2
      exit 64
      ;;
  esac
done

# Fall back to the package script when stdout is redirected or /dev/tty is not
# available. The interactive UI needs a controlling terminal for keypresses.
if [[ ! -t 1 ]] || ! stty -g </dev/tty >/dev/null 2>&1; then
  exec npm run dev
fi

# ── Colors & symbols ─────────────────────────────────────────────────────────
RED=$'\033[31m' GRN=$'\033[32m' YLW=$'\033[33m' CYN=$'\033[36m'
BLD=$'\033[1m'  DIM=$'\033[2m'  RST=$'\033[0m'

SPIN=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
TICK=✓  CROSS=✗

# ── Mailpit binary detection ──────────────────────────────────────────────────
MAILPIT_BIN=""
if command -v mailpit &>/dev/null; then
  MAILPIT_BIN=$(command -v mailpit)
elif [[ -x /opt/homebrew/opt/mailpit/bin/mailpit ]]; then
  MAILPIT_BIN=/opt/homebrew/opt/mailpit/bin/mailpit
elif [[ -x /usr/local/opt/mailpit/bin/mailpit ]]; then
  MAILPIT_BIN=/usr/local/opt/mailpit/bin/mailpit
fi

# ── Temp files ────────────────────────────────────────────────────────────────
API_LOG=$(mktemp)
WEB_LOG=$(mktemp)
MAILPIT_LOG=$(mktemp)
KEY_FILE=$(mktemp)

# ── Process state ─────────────────────────────────────────────────────────────
# Values: starting | ready | error | skipped
API_STATE="starting"
WEB_STATE="starting"
MAILPIT_STATE="starting"
API_URL=""
WEB_URL=""
MAILPIT_URL=""
API_PID=""
WEB_PID=""
MAILPIT_PID=""
KEY_READER_PID=""

# ── LAN hostname (remote mode) ────────────────────────────────────────────────
REMOTE_URL=""
if [[ "$REMOTE" == true ]]; then
  LAN_HOSTNAME=$(scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null || true)
  if [[ -n "$LAN_HOSTNAME" ]]; then
    REMOTE_URL="https://${LAN_HOSTNAME}.local:5173"
  fi
fi

# ── View state ────────────────────────────────────────────────────────────────
# Values: status | api | web | mailpit
VIEW="status"
FRAME=0

# ── Terminal setup ────────────────────────────────────────────────────────────
OLD_STTY=$(stty -g </dev/tty)
stty -echo -icanon </dev/tty

hide_cursor() { printf '\033[?25l'; }
show_cursor()  { printf '\033[?25h'; }

# ── Cleanup ───────────────────────────────────────────────────────────────────
_cleanup() {
  trap '' EXIT INT TERM HUP
  [[ -n "$KEY_READER_PID" ]] && kill "$KEY_READER_PID" 2>/dev/null || true
  [[ -n "$API_PID" ]]        && kill "$API_PID"        2>/dev/null || true
  [[ -n "$WEB_PID" ]]        && kill "$WEB_PID"        2>/dev/null || true
  [[ -n "$MAILPIT_PID" ]]    && kill "$MAILPIT_PID"    2>/dev/null || true
  wait 2>/dev/null || true
  rm -f "$API_LOG" "$WEB_LOG" "$MAILPIT_LOG" "$KEY_FILE"
  stty "$OLD_STTY" </dev/tty 2>/dev/null || true
  show_cursor
  printf '\n'
  exit 0
}
trap _cleanup EXIT INT TERM HUP

# ── Background key reader ─────────────────────────────────────────────────────
# Blocking single-char reads from the terminal; writes each char to KEY_FILE.
# Runs independently so the main loop can use plain sleep for animation timing.
(
  while true; do
    char=''
    IFS= read -r -n 1 char </dev/tty 2>/dev/null || break
    [[ -n "$char" ]] && printf '%s' "$char" > "$KEY_FILE"
  done
) &
KEY_READER_PID=$!

# ── Strip ANSI escape codes (BSD sed compatible) ──────────────────────────────
strip_ansi() {
  sed $'s/\033\\[[0-9;]*[mGKHFJ]//g'
}

# ── Static header (lines 1–4, never redrawn) ─────────────────────────────────
draw_header() {
  printf '\033[2J\033[H'
  printf '  %s%s╔═════════════════╗%s\n' "$BLD" "$CYN" "$RST"
  printf '  %s%s║    Linklater    ║%s\n' "$BLD" "$CYN" "$RST"
  printf '  %s%s╚═════════════════╝%s\n' "$BLD" "$CYN" "$RST"
  printf '\n'
}

# ── Service row ───────────────────────────────────────────────────────────────
render_service_line() {
  local state=$1 url=$2 frame_char=$3 label=$4
  case "$state" in
    starting) printf "${YLW}%s${RST} %-7s  ${DIM}starting${RST}"      "$frame_char" "$label" ;;
    ready)    printf "${GRN}%s${RST} %-7s  ${GRN}%s${RST}"          "$TICK"       "$label" "$url" ;;
    error)    printf "${RED}%s${RST} %-7s  ${RED}error${RST}"       "$CROSS"      "$label" ;;
    skipped)  printf "${DIM}– %-7s  not installed${RST}"             "$label" ;;
  esac
}

# ── LAN row (remote mode only) ────────────────────────────────────────────────
render_lan_line() {
  [[ -z "$REMOTE_URL" ]] && return
  printf "${CYN}↗${RST} %-7s  ${CYN}%s${RST}" "LAN" "$REMOTE_URL"
}

# ── Status view ───────────────────────────────────────────────────────────────
render_status_view() {
  local frame_char=$1
  local out=''
  out+=$'\033[5;1H\033[0J'

  out+="  $(render_service_line "$API_STATE" "$API_URL" "$frame_char" "API")"$'\n'
  out+="  $(render_service_line "$WEB_STATE" "$WEB_URL" "$frame_char" "Web")"$'\n'
  out+="  $(render_service_line "$MAILPIT_STATE" "$MAILPIT_URL" "$frame_char" "Mailpit")"$'\n'
  if [[ -n "$REMOTE_URL" ]]; then
    out+="  $(render_lan_line)"$'\n'
  fi
  out+=$'\n'

  if [[ "$API_STATE" == "ready" && "$WEB_STATE" == "ready" && \
        ("$MAILPIT_STATE" == "ready" || "$MAILPIT_STATE" == "skipped") ]]; then
    out+="  ${GRN}${BLD}Ready.${RST}"$'\n'$'\n'
    out+="  ${DIM}1. API logs"$'\n'
    out+="  2. Web logs"$'\n'
    if [[ "$MAILPIT_STATE" == "ready" ]]; then
      out+="  3. Mailpit logs"$'\n'
    fi
    out+="${RST}"$'\n'
    out+="  Press Control+C to stop"
  elif [[ "$API_STATE" == "error" || "$WEB_STATE" == "error" || "$MAILPIT_STATE" == "error" ]]; then
    out+="  ${RED}${BLD}An error occurred.${RST}"$'\n'$'\n'
    out+="  ${DIM}1. API logs"$'\n'
    out+="  2. Web logs"$'\n'
    if [[ "$MAILPIT_STATE" != "skipped" ]]; then
      out+="  3. Mailpit logs"$'\n'
    fi
    out+="${RST}"$'\n'
    out+="  Press Control+C to stop"
  else
    out+="  ${DIM}Starting up…${RST}"
  fi

  printf '%s' "$out"
}

# ── Log view ──────────────────────────────────────────────────────────────────
render_log_view() {
  local frame_char=$1 label=$2 log_file=$3
  local stty_size; stty_size=$(stty size </dev/tty 2>/dev/null)
  local rows; rows=${stty_size%% *}; rows=${rows:-24}
  local cols; cols=${stty_size##* }; cols=${cols:-80}
  local content_width=$(( cols - 4 ))
  (( content_width < 20 )) && content_width=20
  local available
  if [[ "$MAILPIT_STATE" == "skipped" ]]; then
    available=$(( rows - 16 ))
  else
    available=$(( rows - 17 ))
  fi
  [[ -n "$REMOTE_URL" ]] && available=$(( available - 1 ))
  (( available < 1 )) && available=1
  local divider; printf -v divider '%*s' "$content_width" ''
  divider=${divider// /─}

  local out=''
  out+=$'\033[5;1H\033[0J'

  out+="  $(render_service_line "$API_STATE" "$API_URL" "$frame_char" "API")"$'\n'
  out+="  $(render_service_line "$WEB_STATE" "$WEB_URL" "$frame_char" "Web")"$'\n'
  out+="  $(render_service_line "$MAILPIT_STATE" "$MAILPIT_URL" "$frame_char" "Mailpit")"$'\n'
  if [[ -n "$REMOTE_URL" ]]; then
    out+="  $(render_lan_line)"$'\n'
  fi
  out+=$'\n'
  out+="  ${DIM}0. (back to status)${RST}"$'\n'$'\n'

  if [[ "$label" == "API" ]]; then
    out+="  →  API logs"$'\n'
  else
    out+="  ${DIM}1. API logs${RST}"$'\n'
  fi

  if [[ "$label" == "Web" ]]; then
    out+="  →  Web logs"$'\n'
  else
    out+="  ${DIM}2. Web logs${RST}"$'\n'
  fi

  if [[ "$MAILPIT_STATE" != "skipped" ]]; then
    if [[ "$label" == "Mailpit" ]]; then
      out+="  →  Mailpit logs"$'\n'
    else
      out+="  ${DIM}3. Mailpit logs${RST}"$'\n'
    fi
  fi

  out+=$'\n'

  local prefix_len=$(( ${#label} + 8 ))
  local divider_width=$(( content_width - prefix_len ))
  (( divider_width < 0 )) && divider_width=0
  out+="  ${DIM}── ${label} ${divider:0:$divider_width}${RST}"$'\n'$'\n'

  local service_state
  if [[ "$log_file" == "$API_LOG" ]]; then
    service_state="$API_STATE"
  elif [[ "$log_file" == "$MAILPIT_LOG" ]]; then
    service_state="$MAILPIT_STATE"
  else
    service_state="$WEB_STATE"
  fi

  if [[ "$service_state" == "error" ]]; then
    # Start from 2 lines before the first error so the full message is visible
    local error_line
    error_line=$(grep -n 'Error\|EADDR\|EACCES\|UnhandledPromise\|Cannot find module' \
                 "$log_file" 2>/dev/null | head -1 | cut -d: -f1)
    if [[ -n "$error_line" && "$error_line" -gt 2 ]]; then
      local start=$(( error_line - 2 ))
      while IFS= read -r line; do
        out+="  ${DIM}${line:0:$content_width}${RST}"$'\n'
      done < <(sed -n "${start},$((start + available - 1))p" "$log_file" 2>/dev/null | strip_ansi || true)
    else
      while IFS= read -r line; do
        out+="  ${DIM}${line:0:$content_width}${RST}"$'\n'
      done < <(tail -n "$available" "$log_file" 2>/dev/null | strip_ansi || true)
    fi
  else
    while IFS= read -r line; do
      out+="  ${DIM}${line:0:$content_width}${RST}"$'\n'
    done < <(tail -n "$available" "$log_file" 2>/dev/null | strip_ansi || true)
  fi

  printf '%s' "$out"
}

# ── Free stale port ──────────────────────────────────────────────────────────
# Kill any process holding the API port so a leftover Node from a previous run
# doesn't crash startup with EADDRINUSE.
free_port() {
  local port=$1 log=$2
  local pids
  pids=$(lsof -ti tcp:"$port" -sTCP:LISTEN 2>/dev/null || true)
  if [[ -n "$pids" ]]; then
    printf 'Freeing port %s (killing PID %s)\n' "$port" "$(echo "$pids" | tr '\n' ' ')" >>"$log"
    # shellcheck disable=SC2086
    kill -9 $pids 2>/dev/null || true
    # Brief pause to let the kernel release the socket before bind().
    sleep 0.2
  fi
}

# ── Launch services ───────────────────────────────────────────────────────────
hide_cursor
draw_header

API_PORT="${PORT:-3000}"
free_port "$API_PORT" "$API_LOG"

npm run dev --workspace @linklater/api </dev/null >>"$API_LOG" 2>&1 &
API_PID=$!

if [[ "$REMOTE" == true ]]; then
  VITE_API_BASE_URL=/api npm run dev --workspace @linklater/web -- --host </dev/null >"$WEB_LOG" 2>&1 &
else
  npm run dev --workspace @linklater/web </dev/null >"$WEB_LOG" 2>&1 &
fi
WEB_PID=$!

if [[ -n "$MAILPIT_BIN" ]]; then
  "$MAILPIT_BIN" </dev/null >"$MAILPIT_LOG" 2>&1 &
  MAILPIT_PID=$!
else
  MAILPIT_STATE="skipped"
fi

# ── Live update loop ──────────────────────────────────────────────────────────
DIRTY=true  # always draw on first tick

while true; do
  PREV_API_STATE="$API_STATE"
  PREV_WEB_STATE="$WEB_STATE"
  PREV_MAILPIT_STATE="$MAILPIT_STATE"
  PREV_VIEW="$VIEW"

  # Poll for keypress written by background reader
  key=''
  if [[ -s "$KEY_FILE" ]]; then
    key=$(< "$KEY_FILE")
    : > "$KEY_FILE"
  fi

  case "$key" in
    0) VIEW="status" ;;
    1) VIEW="api" ;;
    2) VIEW="web" ;;
    3) [[ "$MAILPIT_STATE" != "skipped" ]] && VIEW="mailpit" ;;
  esac

  # Detect ready signals
  if [[ "$API_STATE" == "starting" ]] && \
     grep -q "Nest application successfully started" "$API_LOG" 2>/dev/null; then
    PORT=$(grep -oE 'Listening on port [0-9]+' "$API_LOG" 2>/dev/null \
           | grep -oE '[0-9]+$' | tail -1 || true)
    API_URL="https://localhost:${PORT:-3000}"
    API_STATE="ready"
  fi

  if [[ "$WEB_STATE" == "starting" ]]; then
    EXTRACTED=$(grep 'Local:' "$WEB_LOG" 2>/dev/null \
                | grep -oE 'https?://[^ ]+' | tail -1 || true)
    if [[ -n "$EXTRACTED" ]]; then
      WEB_URL="${EXTRACTED%/}"
      WEB_STATE="ready"
    fi
  fi

  if [[ "$MAILPIT_STATE" == "starting" ]] && \
     grep -q "starting on" "$MAILPIT_LOG" 2>/dev/null; then
    MAILPIT_URL="http://localhost:8025"
    MAILPIT_STATE="ready"
  fi

  # Detect crashes – process death or fatal error in log
  if [[ "$API_STATE" != "error" ]]; then
    if ! kill -0 "$API_PID" 2>/dev/null || \
       grep -qE '(EADDRINUSE|EACCES|UnhandledPromiseRejection|Error:.*listen)' "$API_LOG" 2>/dev/null; then
      API_STATE="error"
      VIEW="api"
    fi
  fi
  if [[ "$WEB_STATE" != "error" ]]; then
    if ! kill -0 "$WEB_PID" 2>/dev/null || \
       grep -qE '(EADDRINUSE|EACCES|error when starting dev server)' "$WEB_LOG" 2>/dev/null; then
      WEB_STATE="error"
      VIEW="web"
    fi
  fi
  if [[ "$MAILPIT_STATE" != "error" && "$MAILPIT_STATE" != "skipped" ]]; then
    if ! kill -0 "$MAILPIT_PID" 2>/dev/null || \
       grep -qE '(EADDRINUSE|EACCES)' "$MAILPIT_LOG" 2>/dev/null; then
      MAILPIT_STATE="error"
      VIEW="mailpit"
    fi
  fi

  # Mark dirty when state changed, key pressed, or spinner is animating
  if [[ "$API_STATE"  != "$PREV_API_STATE"  || "$WEB_STATE"  != "$PREV_WEB_STATE"  || \
        "$MAILPIT_STATE" != "$PREV_MAILPIT_STATE" || "$VIEW" != "$PREV_VIEW"       || \
        -n "$key" || "$API_STATE" == "starting" || "$WEB_STATE" == "starting" || \
        "$MAILPIT_STATE" == "starting" ]]; then
    DIRTY=true
  fi

  # Render only when something changed
  if [[ "$DIRTY" == true ]]; then
    frame_char="${SPIN[$((FRAME % ${#SPIN[@]}))]}"
    FRAME=$(( FRAME + 1 ))
    DIRTY=false
    case "$VIEW" in
      status)  render_status_view "$frame_char" ;;
      api)     render_log_view "$frame_char" "API"  "$API_LOG"  ;;
      web)     render_log_view "$frame_char" "Web"  "$WEB_LOG"  ;;
      mailpit) render_log_view "$frame_char" "Mailpit" "$MAILPIT_LOG" ;;
    esac
  fi

  sleep 0.08
done
