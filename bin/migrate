#!/usr/bin/env bash
# migrate – run Prisma migrations against the API workspace

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
ROOT_DIR=$(cd -- "$SCRIPT_DIR/.." && pwd)
cd "$ROOT_DIR" || exit

# shellcheck source=lib/cli.sh disable=SC1091
. "$SCRIPT_DIR/lib/cli.sh" 2>/dev/null ||
  { printf 'Cannot load %s/lib/cli.sh\n' "$SCRIPT_DIR" >&2; exit 70; }

usage() {
  cat <<'USAGE'
Usage: bin/migrate [options]

Runs Prisma migrations for the @linklater/api workspace.

Examples:
  bin/migrate                  Apply pending migrations
  bin/migrate --reset          Wipe the database and re-run every migration
  bin/migrate --reset --force  Wipe the database without confirming first

Options:
  --reset      Wipe the database and re-run all migrations from scratch.
  --force      Answer the --reset confirmation up front.
  --no-input   Refuse --reset rather than ask for confirmation.
  --no-color   Disable colored output.
  --version    Print the version and exit.
  -h, --help   Show this help.

See README.md for setup and usage notes.
USAGE
}

KNOWN_FLAGS=(--reset --force --no-input --no-color --version --help -h)

suggest_flag() {
  local candidate
  for candidate in "${KNOWN_FLAGS[@]}"; do
    if [[ "$candidate" == "$1"* || "$1" == "$candidate"* ]]; then
      printf 'Did you mean %s?' "$candidate"
      return
    fi
  done
}

scan_help "$@"

TARGET="migrate"
FORCE=false
NO_INPUT=false
USE_COLOR=true

for argument in "$@"; do
  case "$argument" in
    --reset)
      TARGET="migrate:reset"
      ;;
    --force)
      FORCE=true
      ;;
    --no-input)
      NO_INPUT=true
      ;;
    --no-color)
      USE_COLOR=false
      ;;
    --version)
      print_version
      ;;
    *)
      unknown_flag "$argument" "$(suggest_flag "$argument")"
      ;;
  esac
done

resolve_color "$USE_COLOR"
probe_terminal

if [[ "$TARGET" == "migrate:reset" && "$FORCE" == true ]]; then
  TARGET="migrate:reset:force"
elif [[ "$TARGET" == "migrate:reset" ]]; then
  if [[ "$NO_INPUT" == true || "$TERMINAL_REACHABLE" == false ]]; then
    printf 'Refusing to reset the database without confirmation. --force resets without asking.\n' >&2
    exit 66
  fi

  printf '%sThis wipes the database and re-runs every migration.%s\n' "$BLD" "$RST" > /dev/tty
  printf 'Type reset to continue: ' > /dev/tty
  CONFIRMATION=""
  read -r CONFIRMATION < /dev/tty || true
  CONFIRMATION=$(printf '%s' "$CONFIRMATION" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')

  if [[ "$CONFIRMATION" != "reset" ]]; then
    printf 'Cancelled. The database was not touched.\n' >&2
    exit 130
  fi
fi

printf '%sRunning npm run %s --workspace @linklater/api%s\n' "$DIM" "$TARGET" "$RST" >&2
exec npm run "$TARGET" --workspace @linklater/api
