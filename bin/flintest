#!/usr/bin/env bash
# flintest – run install, format, lint, typecheck, test, build, with options

set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
ROOT_DIR=$(cd -- "$SCRIPT_DIR/.." && pwd)
cd "$ROOT_DIR" || exit

# shellcheck source=lib/cli.sh disable=SC1091
. "$SCRIPT_DIR/lib/cli.sh" 2>/dev/null ||
  { printf 'Cannot load %s/lib/cli.sh\n' "$SCRIPT_DIR" >&2; exit 70; }

# ── Arguments ───────────────────────────────────────────────────────────────────
usage() {
  cat <<'USAGE'
Usage: bin/flintest [options]

Runs the project quality gate in order:
  npm install
  node scripts/generate-email-palette.mjs
  npm run subset-fa --workspace @linklater/web
  npm run format
  npm run lint
  npm run typecheck
  npm run lint:migrations
  npm run test:cov
  npm run build

Examples:
  bin/flintest             Run the quality gate
  bin/flintest --update    Update dependencies first, then run the gate
  bin/flintest --tuffgal   Run the local visual regression check instead

Options:
  --update     Run npm update before npm install.
  --tuffgal    Replace the default chain with a local visual regression run that
               self-diffs against the per-machine, git-ignored cache:
                 npm install
                 npx --no playwright install chromium
                 npm run tuffgal:setup
                 npx tuffgal run --local --manage-servers
               Opens the HTML report. When the run finds new or changed stories,
               it then prompts to approve them into the local cache. Committed
               baselines (tuffgal/baselines) are still CI-only; approving here
               only refreshes your local reference so the next run is clean.
  --no-input   Skip the approval prompt instead of asking.
  --no-pager   Print failure output in full instead of paging it.
  --no-color   Disable colored output.
  --version    Print the version and exit.
  -h, --help   Show this help.

See README.md for setup and usage notes.
USAGE
}

scan_help "$@"

RUN_UPDATE=false
RUN_TUFFGAL=false
NO_INPUT=false
NO_PAGER=false
USE_COLOR=true

for argument in "$@"; do
  case "$argument" in
    --update)
      RUN_UPDATE=true
      ;;
    --tuffgal)
      RUN_TUFFGAL=true
      ;;
    --no-input)
      NO_INPUT=true
      ;;
    --no-pager)
      NO_PAGER=true
      ;;
    --no-color)
      USE_COLOR=false
      ;;
    --version)
      print_version
      ;;
    *)
      unknown_flag "$argument"
      ;;
  esac
done

if [[ "$RUN_UPDATE" == true && "$RUN_TUFFGAL" == true ]]; then
  printf '%s\n\n' '--update and --tuffgal cannot be combined.' >&2
  usage >&2
  exit 64
fi

# ── Terminal capability ─────────────────────────────────────────────────────────
probe_terminal

PAGER_COMMAND=(less -FIRX)
if [[ -n "${PAGER:-}" ]]; then
  read -r -a PAGER_COMMAND <<< "$PAGER"
fi

# ── Colors & symbols ────────────────────────────────────────────────────────────
resolve_color "$USE_COLOR"

SPIN=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
TICK=✓  CROSS=✗  CIRCLE=○

# ── Layout constants ────────────────────────────────────────────────────────────
if [[ "$RUN_TUFFGAL" == true ]]; then
  STEPS=(Install Playwright Database Test Report)
elif [[ "$RUN_UPDATE" == true ]]; then
  STEPS=(Update Install Generate Subset\ FA Format Lint Typecheck Lint\ Migrations Test Build)
else
  STEPS=(Install Generate Subset\ FA Format Lint Typecheck Lint\ Migrations Test Build)
fi
NS=${#STEPS[@]}

# Lines from status/cursor to step index i (0-based)
step_up() { echo $(( NS - $1 + 1 )); }

_spinner_pid=""

# ── Cursor helpers ──────────────────────────────────────────────────────────────
hide_cursor() { [[ "$TTY_AVAILABLE" == true ]] && printf '\033[?25l'; }
# shellcheck disable=SC2329 # Invoked by _cleanup, which is registered as a trap.
show_cursor()  { [[ "$TTY_AVAILABLE" == true ]] && printf '\033[?25h'; }

# ── Cleanup on exit ─────────────────────────────────────────────────────────────
CURRENT_STEP="the run"

# shellcheck disable=SC2329 # Invoked by trap.
_cleanup() {
  stop_spinner
  show_cursor
  printf '\n'
}

trap _cleanup EXIT
trap 'printf "\n  Stopping %s.\n" "$CURRENT_STEP" >&2
      stop_spinner
      show_cursor
      trap - EXIT INT TERM HUP
      exit 130' INT TERM HUP

# ── Draw initial UI ─────────────────────────────────────────────────────────────
draw_ui() {
  if [[ "$TTY_AVAILABLE" != true ]]; then
    printf 'Running Linklater checks...\n'
    return
  fi

  printf '\033[2J\033[H'
  printf '  %s%s╔═════════════════╗%s\n' "$BLD" "$CYN" "$RST"
  printf '  %s%s║    Linklater    ║%s\n' "$BLD" "$CYN" "$RST"
  printf '  %s%s╚═════════════════╝%s\n' "$BLD" "$CYN" "$RST"
  printf '\n'
  for name in "${STEPS[@]}"; do
    printf "  ${DIM}${CIRCLE} %s${RST}\n" "$name"
  done
  printf '\n'
  printf '  %sInitializing…%s' "$DIM" "$RST"
}

# Write text onto a step line then return cursor to status line.
write_step() {
  local idx=$1; shift
  if [[ "$TTY_AVAILABLE" != true ]]; then
    printf '  %b\n' "$*"
    return
  fi

  local up; up=$(step_up "$idx")
  printf '\033[%dA\033[2K\r  %b\033[%dB\033[2K\r' "$up" "$*" "$up"
}

set_status() {
  if [[ "$TTY_AVAILABLE" != true ]]; then
    printf '%b\n' "$*"
    return
  fi

  printf '\033[2K\r  %b' "$*"
}

mark_done() { write_step "$1" "${GRN}${TICK} ${STEPS[$1]}${RST}"; }
mark_fail() { write_step "$1" "${RED}${CROSS} ${STEPS[$1]}${RST}"; }

# ── Background spinner ──────────────────────────────────────────────────────────
start_spinner() {
  local idx=$1
  if [[ "$TTY_AVAILABLE" != true ]]; then
    printf '  %s...\n' "${STEPS[$idx]}"
    return
  fi

  local up name
  up=$(step_up "$idx")
  name="${STEPS[$idx]}"
  (
    local i=0
    while true; do
      local frame="${SPIN[$((i % ${#SPIN[@]}))]}"
      printf '\033[%dA\033[2K\r  %s%s %s%s\033[%dB\033[2K\r' \
        "$up" "$YLW" "$frame" "$name" "$RST" "$up" > /dev/tty
      sleep 0.08
      i=$(( i + 1 ))
    done
  ) &
  _spinner_pid=$!
}

stop_spinner() {
  [[ "$TTY_AVAILABLE" == true ]] || return

  if [[ -n "$_spinner_pid" ]]; then
    kill "$_spinner_pid" 2>/dev/null || true
    wait "$_spinner_pid" 2>/dev/null || true
    _spinner_pid=""
  fi
}

# ── Step runner ─────────────────────────────────────────────────────────────────
# run_step <idx> <command> [args…]
# Returns 0 on success, 1 on failure (output stored in STEP_OUTPUT).
STEP_OUTPUT=""
run_step() {
  local idx=$1; shift
  CURRENT_STEP="${STEPS[$idx]}"
  start_spinner "$idx"
  local output rc=0
  output=$("$@" 2>&1) || rc=$?
  stop_spinner
  CURRENT_STEP="the run"
  STEP_OUTPUT="$output"
  if [[ $rc -eq 0 ]]; then
    mark_done "$idx"
    return 0
  else
    mark_fail "$idx"
    return 1
  fi
}

dump_failure() {
  local verdict=$1 body=$2
  local rows body_lines
  rows=$(stty size 2>/dev/null < /dev/tty | cut -d ' ' -f 1)
  body_lines=$(printf '%s\n' "$body" | wc -l)
  if [[ "$NO_PAGER" != true && "$TTY_AVAILABLE" == true && ${rows:-0} -gt 0 ]] \
    && [[ $body_lines -gt $rows ]]; then
    printf '%s\n' "$body" | sed 's/^/  /' | "${PAGER_COMMAND[@]}"
  else
    printf '%s\n' "$body" | sed 's/^/  /' >&2
  fi
  printf '\n  %s%s%s%s\n' "$RED" "$BLD" "$verdict" "$RST" >&2
}

# ── Visual regression summary ───────────────────────────────────────────────────
# Mirrors the "Parse harness outcome" step in tuffgal-action: pulls the totals
# out of results.json so the final status line can show passed/new/changed/failed
# even when the harness exited 0. Empty string when no results.json was
# written (e.g. tuffgal crashed before producing one).
tuffgal_summary() {
  local results="$ROOT_DIR/tuffgal/report/results.json"
  if [[ ! -f "$results" ]]; then
    return
  fi
  # shellcheck disable=SC2016 # ${} below are JS template literals, not shell
  node -e '
    const path = process.argv[1];
    const raw = require("fs").readFileSync(path, "utf8");
    const totals = JSON.parse(raw).totals ?? {};
    const passed = totals.passed ?? 0;
    const newish = totals.new ?? 0;
    const changed = totals.changed ?? 0;
    const failed = totals.failed ?? 0;
    const stories = totals.stories ?? 0;
    process.stdout.write(`${passed}/${stories} passed, ${newish} new, ${changed} changed, ${failed} failed`);
  ' "$results" 2>/dev/null
}

# Echo "<new> <changed>" from the last run, or nothing when no results.json.
tuffgal_drift_counts() {
  local results="$ROOT_DIR/tuffgal/report/results.json"
  if [[ ! -f "$results" ]]; then
    return
  fi
  # shellcheck disable=SC2016 # ${} below are JS template literals, not shell
  node -e '
    const path = process.argv[1];
    const totals = JSON.parse(require("fs").readFileSync(path, "utf8")).totals ?? {};
    process.stdout.write(`${totals.new ?? 0} ${totals.changed ?? 0}`);
  ' "$results" 2>/dev/null
}

# Open the HTML report in the default browser (macOS `open`). No-op without a TTY.
# shellcheck disable=SC2329 # Invoked indirectly via `run_step 4 open_report`.
open_report() {
  local report="$ROOT_DIR/tuffgal/report/index.html"
  if [[ "$TTY_AVAILABLE" != true || ! -f "$report" ]]; then
    return
  fi
  open "$report" >/dev/null 2>&1 || true
}

# ── Main ────────────────────────────────────────────────────────────────────────
hide_cursor
draw_ui

FAILED_STEP=""
FAILED_OUTPUT=""

if [[ "$RUN_TUFFGAL" == true ]]; then
  if ! run_step 0 npm install; then
    FAILED_STEP="Install"
    FAILED_OUTPUT="$STEP_OUTPUT"
  fi

  if [[ -z "$FAILED_STEP" ]]; then
    if ! run_step 1 npx --no playwright install chromium; then
      FAILED_STEP="Playwright"
      FAILED_OUTPUT="$STEP_OUTPUT"
    fi
  fi

  if [[ -z "$FAILED_STEP" ]]; then
    if ! run_step 2 npm run tuffgal:setup; then
      FAILED_STEP="Database"
      FAILED_OUTPUT="$STEP_OUTPUT"
    fi
  fi

  # Local advisory mode self-diffs against the git-ignored per-machine cache and
  # exits 0 even on drift, so a non-zero exit here is a real failure (crash, dead
  # server), never "screenshots changed".
  if [[ -z "$FAILED_STEP" ]]; then
    if ! run_step 3 npx tuffgal run --local --manage-servers; then
      FAILED_STEP="Test"
      FAILED_OUTPUT="$STEP_OUTPUT"
    fi
  fi

  TUFFGAL_SUMMARY=$(tuffgal_summary)

  if [[ -n "$FAILED_STEP" ]]; then
    if [[ -n "$TUFFGAL_SUMMARY" ]]; then
      set_status "${RED}${BLD}${FAILED_STEP} failed – see below.${RST} ${DIM}${TUFFGAL_SUMMARY}${RST}"
    else
      set_status "${RED}${BLD}${FAILED_STEP} failed – see below.${RST}"
    fi
    [[ "$TTY_AVAILABLE" == true ]] && printf '\n'
    printf '\n'
    dump_failure "${FAILED_STEP} failed." "$FAILED_OUTPUT"
    exit 1
  fi

  # Run succeeded. Surface the HTML report, then offer to fold any drift into the
  # local cache so the next run comes back clean.
  run_step 4 open_report

  read -r TUFFGAL_NEW TUFFGAL_CHANGED <<< "$(tuffgal_drift_counts)"
  TUFFGAL_NEW=${TUFFGAL_NEW:-0}
  TUFFGAL_CHANGED=${TUFFGAL_CHANGED:-0}

  if [[ -n "$TUFFGAL_SUMMARY" ]]; then
    set_status "${GRN}${BLD}Visual regression complete${RST}\n  ${DIM}${TUFFGAL_SUMMARY}${RST}"
  else
    set_status "${GRN}${BLD}Visual regression complete${RST}"
  fi

  if [[ "$NO_INPUT" != true && "$TERMINAL_REACHABLE" == true && $(( TUFFGAL_NEW + TUFFGAL_CHANGED )) -gt 0 ]]; then
    show_cursor
    printf '\n\n  %sApprove %s new + %s changed into the local cache?%s [y/N] ' \
      "$BLD" "$TUFFGAL_NEW" "$TUFFGAL_CHANGED" "$RST" > /dev/tty
    APPROVE_REPLY=""
    read -r APPROVE_REPLY < /dev/tty || true
    if [[ "$APPROVE_REPLY" =~ ^[Yy]([Ee][Ss])?$ ]]; then
      printf '\n'
      if APPROVE_OUTPUT=$(npx tuffgal approve 2>&1); then
        printf '  %s%s Local cache refreshed – next run will be clean.%s\n' "$GRN" "$TICK" "$RST"
      else
        printf '  %s%s tuffgal approve failed – see below.%s\n\n' "$RED" "$CROSS" "$RST" >&2
        dump_failure "tuffgal approve failed." "$APPROVE_OUTPUT"
        exit 1
      fi
    else
      printf '\n  %sLeft as-is. Re-run to re-check, or approve later with npm run tuffgal:approve.%s\n' \
        "$DIM" "$RST"
    fi
  else
    [[ "$TTY_AVAILABLE" == true ]] && printf '\n'
  fi
  exit 0
fi

# Build step index offset based on whether --update was requested
STEP_OFFSET=0

if [[ "$RUN_UPDATE" == true ]]; then
  if ! run_step 0 npm update; then
    FAILED_STEP="Update"
    FAILED_OUTPUT="$STEP_OUTPUT"
  fi
  STEP_OFFSET=1
fi

if [[ -z "$FAILED_STEP" ]]; then
  if ! run_step "$STEP_OFFSET" npm install; then
    FAILED_STEP="Install"
    FAILED_OUTPUT="$STEP_OUTPUT"
  fi
fi

if [[ -z "$FAILED_STEP" ]]; then
  if ! run_step $(( STEP_OFFSET + 1 )) node scripts/generate-email-palette.mjs; then
    FAILED_STEP="Generate"
    FAILED_OUTPUT="$STEP_OUTPUT"
  fi
fi

if [[ -z "$FAILED_STEP" ]]; then
  if ! run_step $(( STEP_OFFSET + 2 )) npm run subset-fa --workspace @linklater/web; then
    FAILED_STEP="Subset FA"
    FAILED_OUTPUT="$STEP_OUTPUT"
  fi
fi

if [[ -z "$FAILED_STEP" ]]; then
  if ! run_step $(( STEP_OFFSET + 3 )) npm run format; then
    FAILED_STEP="Format"
    FAILED_OUTPUT="$STEP_OUTPUT"
  fi
fi

if [[ -z "$FAILED_STEP" ]]; then
  if ! run_step $(( STEP_OFFSET + 4 )) npm run lint; then
    FAILED_STEP="Lint"
    FAILED_OUTPUT="$STEP_OUTPUT"
  fi
fi

if [[ -z "$FAILED_STEP" ]]; then
  if ! run_step $(( STEP_OFFSET + 5 )) npm run typecheck; then
    FAILED_STEP="Typecheck"
    FAILED_OUTPUT="$STEP_OUTPUT"
  fi
fi

if [[ -z "$FAILED_STEP" ]]; then
  if ! run_step $(( STEP_OFFSET + 6 )) npm run lint:migrations; then
    FAILED_STEP="Lint Migrations"
    FAILED_OUTPUT="$STEP_OUTPUT"
  fi
fi

if [[ -z "$FAILED_STEP" ]]; then
  if ! run_step $(( STEP_OFFSET + 7 )) npm run test:cov; then
    FAILED_STEP="Test"
    FAILED_OUTPUT="$STEP_OUTPUT"
  fi
fi

if [[ -z "$FAILED_STEP" ]]; then
  if ! run_step $(( STEP_OFFSET + 8 )) npm run build; then
    FAILED_STEP="Build"
    FAILED_OUTPUT="$STEP_OUTPUT"
  fi
fi

if [[ -z "$FAILED_STEP" ]]; then
  set_status "${GRN}${BLD}All checks passed.${RST}"
  [[ "$TTY_AVAILABLE" == true ]] && printf '\n'
  exit 0
else
  set_status "${RED}${BLD}${FAILED_STEP} failed – see below.${RST}"
  [[ "$TTY_AVAILABLE" == true ]] && printf '\n'
  printf '\n'
  dump_failure "${FAILED_STEP} failed." "$FAILED_OUTPUT"
  exit 1
fi
