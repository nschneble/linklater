#!/usr/bin/env bash
# flintest – run install, format, lint, test, and build with optional updates

set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT_DIR=$(cd -- "$SCRIPT_DIR/.." && pwd)
cd "$ROOT_DIR" || exit

# ── Arguments ───────────────────────────────────────────────────────────────────
usage() {
  cat <<'USAGE'
Usage: bin/flintest [--update]

Runs the project quality gate in order:
  npm install
  npm run format
  npm run lint
  npm run lint:migrations
  npm run test:cov
  npm run build

Options:
  --update   Run npm update before npm install.
  -h, --help Show this help.
USAGE
}

RUN_UPDATE=false
for arg in "$@"; do
  case "$arg" in
    --update)
      RUN_UPDATE=true
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'Unknown option: %s\n\n' "$arg" >&2
      usage >&2
      exit 64
      ;;
  esac
done

# ── Terminal capability ─────────────────────────────────────────────────────────
TTY_AVAILABLE=false
if [[ -t 1 ]] && [[ -w /dev/tty ]]; then
  TTY_AVAILABLE=true
fi

# ── Colors & symbols ────────────────────────────────────────────────────────────
if [[ "$TTY_AVAILABLE" == true ]]; then
  RED=$'\033[31m' GRN=$'\033[32m' CYN=$'\033[36m'
  BLD=$'\033[1m'  DIM=$'\033[2m'  RST=$'\033[0m'
else
  RED='' GRN='' CYN='' BLD='' DIM='' RST=''
fi

SPIN=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
TICK=✓  CROSS=✗  CIRC=○

# ── Layout constants ────────────────────────────────────────────────────────────
if [[ "$RUN_UPDATE" == true ]]; then
  STEPS=(Update Install Generate Format Lint Lint\ Migrations Test Build)
else
  STEPS=(Install Generate Format Lint Lint\ Migrations Test Build)
fi
NS=${#STEPS[@]}

# Lines from status/cursor to step index i (0-based)
step_up() { echo $(( NS - $1 + 1 )); }

_spinner_pid=""

# ── Cursor helpers ──────────────────────────────────────────────────────────────
hide_cursor() { [[ "$TTY_AVAILABLE" == true ]] && printf '\033[?25l'; }
# shellcheck disable=SC2329 # Invoked by _cleanup, which is registered as a trap.
show_cursor()  { [[ "$TTY_AVAILABLE" == true ]] && printf '\033[?25h'; }

# ── Cleanup on exit ─────────────────────────────────────────────────────────────
# shellcheck disable=SC2329 # Invoked by trap.
_cleanup() {
  stop_spinner
  show_cursor
  printf '\n'
}
trap _cleanup EXIT INT TERM HUP

# ── Draw initial UI ─────────────────────────────────────────────────────────────
draw_ui() {
  if [[ "$TTY_AVAILABLE" != true ]]; then
    printf 'Running Linklater checks...\n'
    return
  fi

  printf '\033[2J\033[H'
  printf '  %s%s╔═════════════════╗%s\n' "$BLD" "$CYN" "$RST"
  printf '  %s%s║    Linklater    ║%s\n' "$BLD" "$CYN" "$RST"
  printf '  %s%s╚═════════════════╝%s\n' "$BLD" "$CYN" "$RST"
  printf '\n'
  for name in "${STEPS[@]}"; do
    printf "  ${DIM}${CIRC} %s${RST}\n" "$name"
  done
  printf '\n'
  printf '  %sInitializing…%s' "$DIM" "$RST"
}

# Write text onto a step line then return cursor to status line.
write_step() {
  local idx=$1; shift
  if [[ "$TTY_AVAILABLE" != true ]]; then
    printf '  %b\n' "$*"
    return
  fi

  local up; up=$(step_up "$idx")
  printf '\033[%dA\033[2K\r  %b\033[%dB\033[2K\r' "$up" "$*" "$up"
}

set_status() {
  if [[ "$TTY_AVAILABLE" != true ]]; then
    printf '%b\n' "$*"
    return
  fi

  printf '\033[2K\r  %b' "$*"
}

mark_done() { write_step "$1" "${GRN}${TICK} ${STEPS[$1]}${RST}"; }
mark_fail() { write_step "$1" "${RED}${CROSS} ${STEPS[$1]}${RST}"; }

# ── Background spinner ──────────────────────────────────────────────────────────
start_spinner() {
  local idx=$1
  if [[ "$TTY_AVAILABLE" != true ]]; then
    printf '  %s...\n' "${STEPS[$idx]}"
    return
  fi

  local up name
  up=$(step_up "$idx")
  name="${STEPS[$idx]}"
  (
    local i=0
    while true; do
      local frame="${SPIN[$((i % ${#SPIN[@]}))]}"
      printf '\033[%dA\033[2K\r  \033[33m%s %s\033[0m\033[%dB\033[2K\r' \
        "$up" "$frame" "$name" "$up" > /dev/tty
      sleep 0.08
      i=$(( i + 1 ))
    done
  ) &
  _spinner_pid=$!
}

stop_spinner() {
  [[ "$TTY_AVAILABLE" == true ]] || return

  if [[ -n "$_spinner_pid" ]]; then
    kill "$_spinner_pid" 2>/dev/null || true
    wait "$_spinner_pid" 2>/dev/null || true
    _spinner_pid=""
  fi
}

# ── Step runner ─────────────────────────────────────────────────────────────────
# run_step <idx> <command> [args…]
# Returns 0 on success, 1 on failure (output stored in STEP_OUTPUT).
STEP_OUTPUT=""
run_step() {
  local idx=$1; shift
  start_spinner "$idx"
  local output rc=0
  output=$("$@" 2>&1) || rc=$?
  stop_spinner
  STEP_OUTPUT="$output"
  if [[ $rc -eq 0 ]]; then
    mark_done "$idx"
    return 0
  else
    mark_fail "$idx"
    return 1
  fi
}

# ── Main ────────────────────────────────────────────────────────────────────────
hide_cursor
draw_ui

FAILED_STEP=""
FAILED_OUTPUT=""

# Build step index offset based on whether --update was requested
STEP_OFFSET=0

if [[ "$RUN_UPDATE" == true ]]; then
  if ! run_step 0 npm update; then
    FAILED_STEP="Update"
    FAILED_OUTPUT="$STEP_OUTPUT"
  fi
  STEP_OFFSET=1
fi

if [[ -z "$FAILED_STEP" ]]; then
  if ! run_step "$STEP_OFFSET" npm install; then
    FAILED_STEP="Install"
    FAILED_OUTPUT="$STEP_OUTPUT"
  fi
fi

if [[ -z "$FAILED_STEP" ]]; then
  if ! run_step $(( STEP_OFFSET + 1 )) node scripts/generate-email-palette.mjs; then
    FAILED_STEP="Generate"
    FAILED_OUTPUT="$STEP_OUTPUT"
  fi
fi

if [[ -z "$FAILED_STEP" ]]; then
  if ! run_step $(( STEP_OFFSET + 2 )) npm run format; then
    FAILED_STEP="Format"
    FAILED_OUTPUT="$STEP_OUTPUT"
  fi
fi

if [[ -z "$FAILED_STEP" ]]; then
  if ! run_step $(( STEP_OFFSET + 3 )) npm run lint; then
    FAILED_STEP="Lint"
    FAILED_OUTPUT="$STEP_OUTPUT"
  fi
fi

if [[ -z "$FAILED_STEP" ]]; then
  if ! run_step $(( STEP_OFFSET + 4 )) npm run lint:migrations; then
    FAILED_STEP="Lint"
    FAILED_OUTPUT="$STEP_OUTPUT"
  fi
fi

if [[ -z "$FAILED_STEP" ]]; then
  if ! run_step $(( STEP_OFFSET + 5 )) npm run test:cov; then
    FAILED_STEP="Test"
    FAILED_OUTPUT="$STEP_OUTPUT"
  fi
fi

if [[ -z "$FAILED_STEP" ]]; then
  if ! run_step $(( STEP_OFFSET + 6 )) npm run build; then
    FAILED_STEP="Build"
    FAILED_OUTPUT="$STEP_OUTPUT"
  fi
fi

if [[ -z "$FAILED_STEP" ]]; then
  set_status "${GRN}${BLD}All checks passed.${RST}"
  [[ "$TTY_AVAILABLE" == true ]] && printf '\n'
  exit 0
else
  set_status "${RED}${BLD}${FAILED_STEP} failed – see below.${RST}"
  [[ "$TTY_AVAILABLE" == true ]] && printf '\n'
  printf '\n'
  printf '%s\n' "$FAILED_OUTPUT" | sed 's/^/  /'
  printf '\n'
  exit 1
fi
