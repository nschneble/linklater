{
  "story": "As a logged-in user, I can change my email address — and if I have MFA enabled, I am prompted for a verification code.",
  "flow": "change my email address",
  "needs": ["logged-in"],
  "actions": [
    { "action": "intercept-no-api-tokens" },
    { "action": "intercept-instant-bookmarklet-token" },
    { "action": "intercept-noop-email-change" },
    {
      "action": "change-email",
      "parameters": { "newEmail": "moved@linklater.test" }
    },
    { "action": "intercept-me-mfa-enrolled" },
    { "action": "intercept-email-change-403" },
    {
      "action": "change-email-expect-403",
      "parameters": { "newEmail": "moved@linklater.test" }
    }
  ]
}
