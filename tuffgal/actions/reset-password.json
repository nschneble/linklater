{
  "action": "reset-password",
  "parameters": ["email"],
  "steps": [
    { "kind": "navigate", "path": "/forgot-password" },
    {
      "kind": "input",
      "hint": { "selector": "#forgot-email" },
      "value": "${email}"
    },
    {
      "kind": "click",
      "hint": { "role": "button", "text": "Send password reset link" }
    },
    { "kind": "wait", "ms": 600 }
  ],
  "expect": {
    "anyOf": [{ "selector": "[role='status']" }]
  }
}
