{
  "action": "revoke-token-and-expect-error",
  "steps": [
    { "kind": "navigate", "path": "/settings" },
    {
      "kind": "click",
      "hint": { "role": "button", "text": "Revoke Browser extension" }
    },
    {
      "kind": "click",
      "hint": { "role": "button", "text": "Confirm revoke Browser extension" }
    },
    { "kind": "wait", "ms": 600 },
    {
      "kind": "read",
      "hint": {
        "selector": "[role='alert']:has-text('Internal server error')"
      }
    }
  ],
  "expect": {
    "anyOf": [
      { "selector": "[role='alert']:has-text('Internal server error')" }
    ]
  },
  "mask": [{ "selector": "[role='alert']" }, { "selector": "time" }]
}
