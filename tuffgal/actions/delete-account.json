{
  "action": "delete-account",
  "steps": [
    {
      "kind": "navigate",
      "path": "/settings",
      "waitUntil": "domcontentloaded"
    },
    {
      "kind": "click",
      "hint": { "role": "button", "text": "Delete my account" }
    },
    { "kind": "wait", "ms": 600 },
    { "kind": "scroll", "direction": "down", "amount": 5000 },
    { "kind": "wait", "ms": 600 }
  ],
  "expect": {
    "anyOf": [{ "role": "button", "text": "Cancel account deletion" }]
  }
}
