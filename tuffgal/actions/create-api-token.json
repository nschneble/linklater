{
  "action": "create-api-token",
  "parameters": ["tokenName"],
  "steps": [
    { "kind": "navigate", "path": "/settings", "waitUntil": "domcontentloaded" },
    {
      "kind": "click",
      "hint": { "role": "button", "text": "Generate new token" }
    },
    {
      "kind": "input",
      "hint": { "selector": "#token-name" },
      "value": "${tokenName}"
    },
    {
      "kind": "click",
      "hint": { "role": "button", "text": "Create token" }
    },
    { "kind": "wait", "ms": 1500 }
  ],
  "expect": {
    "anyOf": [
      { "text": "Your new token has been created" }
    ]
  },
  "mask": [
    { "selector": "[aria-label*=\"Personal access token\"]" },
    { "selector": "button[aria-label*=\"Revoke\"]" }
  ]
}
