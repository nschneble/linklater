{
  "action": "create-api-token",
  "parameters": ["tokenName"],
  "steps": [
    {
      "kind": "navigate",
      "path": "/settings",
      "waitUntil": "domcontentloaded"
    },
    {
      "kind": "click",
      "hint": { "role": "button", "text": "Generate new token" }
    },
    {
      "kind": "input",
      "hint": { "selector": "#token-name" },
      "value": "${tokenName}"
    },
    {
      "kind": "click",
      "hint": { "role": "button", "text": "Create token" }
    },
    { "kind": "wait", "ms": 2000 },
    {
      "kind": "click",
      "hint": { "role": "button", "text": "Integrations" }
    },
    { "kind": "wait", "ms": 1000 }
  ],
  "expect": {
    "anyOf": [{ "text": "Your new token has been created" }]
  },
  "mask": [
    { "selector": "[aria-label*=\"Personal access token\"]" },
    { "selector": "button[aria-label*=\"Revoke\"]" }
  ]
}
