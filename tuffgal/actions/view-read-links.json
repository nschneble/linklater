{
  "action": "view-read-links",
  "steps": [
    { "kind": "navigate", "path": "/unread" },
    {
      "kind": "click",
      "hint": { "selector": "#tab-read" }
    },
    {
      "kind": "waitFor",
      "hint": {
        "selector": "#links-list a[aria-label*='Test Link 3']"
      }
    },
    { "kind": "wait", "ms": 700 }
  ],
  "expect": {
    "anyOf": [{ "selector": "#tab-read[aria-selected='true']" }],
    "timeoutMs": 15000
  },
  "mask": [{ "selector": "#suggestion-callout-title" }]
}
