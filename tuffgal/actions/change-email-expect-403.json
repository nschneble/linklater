{
  "action": "change-email-expect-403",
  "parameters": ["newEmail"],
  "steps": [
    { "kind": "navigate", "path": "/settings" },
    {
      "kind": "input",
      "hint": { "selector": "#change-email" },
      "value": "${newEmail}"
    },
    {
      "kind": "click",
      "hint": { "role": "button", "text": "Change email address" }
    },
    { "kind": "wait", "ms": 600 }
  ],
  "expect": {
    "anyOf": [{ "text": "verification code is required" }]
  },
  "mask": [{ "selector": "[role='alert']" }]
}
