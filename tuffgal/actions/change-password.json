{
  "action": "change-password",
  "parameters": ["currentPassword", "newPassword"],
  "steps": [
    { "kind": "navigate", "path": "/settings", "waitUntil": "domcontentloaded" },
    {
      "kind": "input",
      "hint": { "selector": "#new-password" },
      "value": "${newPassword}"
    },
    {
      "kind": "input",
      "hint": { "selector": "#current-password" },
      "value": "${currentPassword}"
    },
    {
      "kind": "click",
      "hint": { "role": "button", "text": "Save new password" }
    },
    { "kind": "wait", "ms": 600 }
  ],
  "expect": {
    "anyOf": [{ "selector": "[role='status']" }]
  },
  "diff": { "maxDiffRatio": 0.02 }
}
