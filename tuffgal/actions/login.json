{
  "action": "login",
  "steps": [
    { "kind": "navigate", "path": "/login" },
    {
      "kind": "input",
      "hint": { "role": "textbox", "text": "Email" },
      "value": "testing-ui@linklater.test"
    },
    {
      "kind": "input",
      "hint": { "role": "textbox", "text": "Password" },
      "value": "testing-ui-correct-horse"
    },
    {
      "kind": "click",
      "hint": { "role": "button", "text": "Log in" }
    },
    { "kind": "wait", "ms": 1200 }
  ],
  "expect": {
    "anyOf": [{ "role": "heading", "text": "Your links" }]
  },
  "mask": [{ "selector": "[aria-live='polite']" }, { "selector": "#suggestion-callout-title" }]
}
