{
  "action": "add-password",
  "parameters": ["password"],
  "steps": [
    { "kind": "navigate", "path": "/settings", "waitUntil": "domcontentloaded" },
    {
      "kind": "input",
      "hint": { "selector": "#add-password-input" },
      "value": "${password}"
    },
    {
      "kind": "click",
      "hint": { "role": "button", "text": "Add password" }
    },
    { "kind": "wait", "ms": 600 }
  ],
  "expect": {
    "anyOf": [{ "role": "heading", "text": "Password" }]
  }
}
