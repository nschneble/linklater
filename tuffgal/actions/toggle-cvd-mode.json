{
  "action": "toggle-cvd-mode",
  "steps": [
    { "kind": "navigate", "path": "/settings", "waitUntil": "domcontentloaded" },
    {
      "kind": "click",
      "hint": { "role": "switch", "text": "Color Vision Deficiency" }
    },
    { "kind": "wait", "ms": 600 }
  ],
  "expect": {
    "anyOf": [{ "selector": "[role=\"switch\"][aria-checked=\"true\"]" }]
  }
}
