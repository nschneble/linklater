{
  "name": "linklater",
  "version": "1.5.0",
  "description": "Linklater is an Instapaper-inspired \u201cread it later\u201d app.",
  "author": "Nick Schneble",
  "private": true,
  "license": "CC0-1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspace @linklater/api && npm run build --workspace @linklater/web",
    "dev": "concurrently \"npm run dev --workspace @linklater/api\" \"npm run dev --workspace @linklater/web\"",
    "dev:test": "node scripts/migrate-test-db.mjs && TESTING_UI=1 DATABASE_URL=$(node scripts/resolve-test-db-url.mjs) concurrently \"npm run dev --workspace @linklater/api\" \"npm run dev --workspace @linklater/web\"",
    "format": "npm run format --workspace @linklater/api && npm run format --workspace @linklater/web",
    "generate:email-palette": "node scripts/generate-email-palette.mjs",
    "lint": "npm run lint --workspace @linklater/api && npm run lint --workspace @linklater/web",
    "lint:migrations": "squawk 'apps/api/prisma/migrations/**/*.sql'",
    "test": "node scripts/run-tests.mjs",
    "test:cov": "npm run test:cov --workspace @linklater/api && npm run test:cov --workspace @linklater/web",
    "tuffgal": "tuffgal run",
    "tuffgal:approve": "tuffgal approve",
    "tuffgal:setup": "node --experimental-strip-types tuffgal/setup.ts",
    "typecheck": "npm run typecheck --workspace @linklater/api",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@types/pg": "^8.20.4",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "pg": "^8.11.0",
    "prettier": "^3.9.5",
    "squawk-cli": "^2.60.0",
    "tuffgal": "0.2.0-alpha.5",
    "typescript-eslint": "^8.66.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "@nestjs/swagger": {
      "js-yaml": "^5.2.2"
    },
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "0.27.2",
    "find-my-way": "^9.7.0",
    "js-yaml": "^4.2.0",
    "multer": "^2.2.0",
    "picomatch": "^4.0.4",
    "shell-quote": "^1.10.0",
    "valibot": "^1.4.2",
    "webpack": "^5.105.0"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "@scarf/scarf@1.4.0": true,
    "esbuild@0.27.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "prisma@7.9.1": true,
    "unrs-resolver@1.12.2": true,
    "@swc/core@1.15.47": true
  }
}
