{
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,
    "target": "ES2022",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "useDefineForClassFields": true,

    /* Bundler mode */
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "verbatimModuleSyntax": true,

    /* Linting */
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
  },
  // Test files are excluded from `tsc -b` so the app build gates only on
  // shipping code. They are not unchecked: `tsconfig.test.json` covers
  // them, and `npm run typecheck:test` runs it.
  //
  // That config is not in the build or CI yet because it still reports
  // 109 errors, genuine partial mocks against `MeResponse` and
  // `LoginResponse` concentrated in a few files. Fix those and the two
  // configs can merge.
  //
  // bundles-color-utils.ts is a test-only shared helper (imports node:fs
  // for parsing bundles.css). Excluded for the same reason — it never
  // ships in the bundle.
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/theme/styles/bundles-color-utils.ts",
  ],
  "include": ["src"]
}
