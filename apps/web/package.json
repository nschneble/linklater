{
  "name": "@linklater/web",
  "version": "1.6.2",
  "description": "Linklater is an Instapaper-inspired “read it later” app.",
  "author": "Nick Schneble",
  "private": true,
  "license": "CC0-1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "format": "prettier --write \"{browser,src,scripts}/**/*.{ts,tsx,mjs}\" playwright.config.ts",
    "lint": "eslint \"{browser,src,scripts}/**/*.{ts,tsx,mjs}\" playwright.config.ts --max-warnings=0",
    "preview": "vite preview",
    "subset-fa": "npm run sync-fa && node scripts/subset-fa-fonts.mjs",
    "sync-fa": "node scripts/sync-fa-manifest.mjs",
    "test": "NODE_OPTIONS=\"--disable-warning=DEP0205\" vitest --run",
    "test:browser": "playwright test",
    "test:cov": "NODE_OPTIONS=\"--disable-warning=DEP0205\" vitest --run --coverage",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "blueimp-md5": "^2.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@nestjs/jwt": "^12.0.5",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/blueimp-md5": "^2.18.2",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-istanbul": "^5.1.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "culori": "^4.0.2",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "openapi-types": "^12.1.3",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-plugin-mkcert": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
