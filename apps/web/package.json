{
  "name": "@linklater/web",
  "version": "1.5.0",
  "description": "Linklater is an Instapaper-inspired \u201cread it later\u201d app.",
  "author": "Nick Schneble",
  "private": true,
  "license": "CC0-1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "format": "prettier --write \"{src,scripts}/**/*.{ts,tsx,mjs}\"",
    "lint": "eslint \"{src,scripts}/**/*.{ts,tsx,mjs}\" --max-warnings=0",
    "preview": "vite preview",
    "subset-fa": "npm run sync-fa && node scripts/subset-fa-fonts.mjs",
    "sync-fa": "node scripts/sync-fa-manifest.mjs",
    "test": "NODE_OPTIONS=\"--disable-warning=DEP0205\" vitest --run",
    "test:cov": "NODE_OPTIONS=\"--disable-warning=DEP0205\" vitest --run --coverage",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "blueimp-md5": "^2.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@nestjs/jwt": "^11.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.4",
    "@types/blueimp-md5": "^2.18.2",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "culori": "^4.0.2",
    "eslint": "^10.8.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.10.0",
    "jsdom": "^30.0.0",
    "openapi-types": "^12.1.3",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-mkcert": "^2.0.0",
    "vitest": "^4.0.15"
  }
}
