generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id      String  @id @default(cuid())
  email   String  @unique
  mode    String  @default("dark")
  theme   String  @default("scanner-darkly")
  cvdMode Boolean @default(false)

  passwordHash      String?
  pendingEmail      String?
  pendingEmailToken String? @unique
  resetToken        String? @unique
  verificationToken String? @unique

  emailVerifiedAt            DateTime?
  pendingEmailTokenExpiresAt DateTime?
  resetTokenExpiresAt        DateTime?
  verificationTokenExpiresAt DateTime?

  totpSecret       String?
  totpEnabledAt    DateTime?
  totpVerifiedAt   DateTime?
  totpLastUsedStep Int?
  mfaNonce         String?

  magicLinkToken          String?   @unique
  magicLinkTokenExpiresAt DateTime?

  accountDeletionToken          String?   @unique
  accountDeletionTokenExpiresAt DateTime?

  welcomedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links              Link[]
  oauthAccounts      OAuthAccount[]
  recoveryCodes      RecoveryCode[]
  apiTokens          ApiToken[]
  refreshTokens      RefreshToken[]
  extensionAuthCodes ExtensionAuthCode[]
}

model RecoveryCode {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

model OAuthAccount {
  id            String @id @default(cuid())
  provider      String
  providerId    String
  providerEmail String
  userId        String
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerId])
  @@index([userId])
}

model Link {
  id     String @id @default(cuid())
  meta   Meta?
  url    String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  searchVector Unsupported("tsvector")?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  readAt    DateTime?

  @@unique([userId, url])
  @@index([userId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

enum TokenKind {
  USER
  BOOKMARKLET
}

model ApiToken {
  id          String    @id @default(cuid())
  name        String
  tokenHash   String    @unique
  prefix      String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  kind        TokenKind @default(USER)
  // Plaintext token value. Populated ONLY when kind = BOOKMARKLET, because the
  // bookmarklet's `javascript:` URL must embed the raw token literally and the
  // settings page needs to retrieve it on every load (including across devices).
  // For kind = USER this column is NULL — those tokens follow the standard
  // hash-only / shown-once model. DB compromise of bookmarklet rows allows
  // saving links as the affected user; users can regenerate to invalidate.
  secretValue String?

  @@index([userId])
  @@index([userId, kind])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model ExtensionAuthCode {
  id            String   @id @default(cuid())
  codeHash      String   @unique
  codeChallenge String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([userId])
}

model Meta {
  id     String @id @default(cuid())
  linkId String @unique
  link   Link   @relation(fields: [linkId], references: [id], onDelete: Cascade)

  description String?
  faviconUrl  String?
  imageUrl    String?
  siteName    String?
  source      String?
  title       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  fetchedAt DateTime?
}

model RssEntry {
  id          String   @id @default(cuid())
  sourceKey   String
  url         String
  title       String
  description String?
  imageUrl    String?
  siteName    String?
  publishedAt DateTime
  fetchedAt   DateTime @default(now())

  @@unique([sourceKey, url])
  @@index([sourceKey, publishedAt(sort: Desc)])
}
