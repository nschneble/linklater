generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String

  mode         String    @default("dark")
  theme        String    @default("scanner-darkly")

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  links        Link[]
}

model Link {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  url          String
  meta         Meta?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archivedAt   DateTime?

  @@index([userId])
  @@index([userId, url])
  @@index([userId, archivedAt])
  @@index([userId, createdAt])
}

model Meta {
  id           String    @id @default(cuid())
  linkId       String    @unique
  link         Link      @relation(fields: [linkId], references: [id], onDelete: Cascade)

  description  String?
  faviconUrl   String?
  imageUrl     String?
  siteName     String?
  source       String?
  title        String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  fetchedAt    DateTime?
}
