generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String @id @default(cuid())
  email String @unique
  mode  String @default("dark")
  theme String @default("scanner-darkly")

  passwordHash      String?
  pendingEmail      String?
  pendingEmailToken String? @unique
  resetToken        String? @unique
  verificationToken String? @unique

  emailVerifiedAt            DateTime?
  pendingEmailTokenExpiresAt DateTime?
  resetTokenExpiresAt        DateTime?
  verificationTokenExpiresAt DateTime?

  totpSecret       String?
  totpEnabledAt    DateTime?
  totpVerifiedAt   DateTime?
  totpLastUsedStep Int?

  magicLinkToken          String?   @unique
  magicLinkTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links              Link[]
  oauthAccounts      OAuthAccount[]
  recoveryCodes      RecoveryCode[]
  apiTokens          ApiToken[]
  refreshTokens      RefreshToken[]
  extensionAuthCodes ExtensionAuthCode[]
}

model RecoveryCode {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

model OAuthAccount {
  id         String @id @default(cuid())
  provider   String
  providerId String
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerId])
  @@index([userId])
}

model Link {
  id     String @id @default(cuid())
  meta   Meta?
  url    String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  searchVector Unsupported("tsvector")?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  readAt    DateTime?

  @@index([userId])
  @@index([userId, url])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model ApiToken {
  id         String    @id @default(cuid())
  name       String
  tokenHash  String    @unique
  prefix     String
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model ExtensionAuthCode {
  id            String   @id @default(cuid())
  codeHash      String   @unique
  codeChallenge String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([userId])
}

model Meta {
  id     String @id @default(cuid())
  linkId String @unique
  link   Link   @relation(fields: [linkId], references: [id], onDelete: Cascade)

  description String?
  faviconUrl  String?
  imageUrl    String?
  siteName    String?
  source      String?
  title       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  fetchedAt DateTime?
}
