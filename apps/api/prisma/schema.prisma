generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id      String  @id @default(cuid())
  email   String  @unique
  mode    String  @default("dark")
  theme   String  @default("scanner-darkly")
  cvdMode Boolean @default(false)

  // Per-user editable "Custom" theme. Holds a { dark, light } map of bundle
  // token names (e.g. "--mount-border") to CSS color strings. Null until the
  // user saves a Custom theme via the Theme Editor. Validation of the exact
  // token set happens client-side; the column stays a free-form JSON blob.
  customTheme Json?

  // Whether the user has opted the Custom theme into the theme picker. The
  // Custom theme is always reachable from the Theme Editor, but stays hidden
  // from the picker menus until the user checks this in the editor.
  customThemeEnabled Boolean @default(false)

  passwordHash      String?
  pendingEmail      String?
  pendingEmailToken String? @unique
  resetToken        String? @unique
  verificationToken String? @unique

  // Bumped whenever an outstanding access token must be force-invalidated
  // before its natural 1h expiry (e.g. a password set before the account's
  // email was ever verified is invalidated out from under a still-live
  // session — see `verifyEmailAndInvalidateStalePassword`). `JwtStrategy`
  // rejects any token whose embedded version doesn't match the current value.
  tokenVersion Int @default(0)

  emailVerifiedAt            DateTime?
  pendingEmailTokenExpiresAt DateTime?
  resetTokenExpiresAt        DateTime?
  verificationTokenExpiresAt DateTime?

  totpSecret       String?
  totpEnabledAt    DateTime?
  totpVerifiedAt   DateTime?
  totpLastUsedStep Int?
  mfaNonce         String?

  magicLinkToken          String?   @unique
  magicLinkTokenExpiresAt DateTime?

  accountDeletionToken          String?   @unique
  accountDeletionTokenExpiresAt DateTime?

  welcomedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links              Link[]
  oauthAccounts      OAuthAccount[]
  recoveryCodes      RecoveryCode[]
  apiTokens          ApiToken[]
  refreshTokens      RefreshToken[]
  extensionAuthCodes ExtensionAuthCode[]
}

model RecoveryCode {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

model OAuthAccount {
  id            String @id @default(cuid())
  provider      String
  providerId    String
  providerEmail String
  userId        String
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerId])
  @@index([userId])
}

model Link {
  id     String @id @default(cuid())
  meta   Meta?
  url    String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  searchVector Unsupported("tsvector")?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  readAt    DateTime?

  @@unique([userId, url])
  @@index([userId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

enum TokenKind {
  USER
  BOOKMARKLET
  API_DOCS
}

model ApiToken {
  id          String    @id @default(cuid())
  name        String
  tokenHash   String    @unique
  prefix      String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  kind        TokenKind @default(USER)
  // Plaintext token value. Populated for the retrievable kinds (BOOKMARKLET and
  // API_DOCS) because their consumers must re-read the raw token on every load:
  // the bookmarklet embeds it in a `javascript:` URL. The API_DOCS token is
  // still auto-provisioned server-side, though the former in-page "try it out"
  // explorer that re-read it was removed (its teardown is deferred).
  // For kind = USER this column is NULL — those tokens follow the standard
  // hash-only / shown-once model. DB compromise of these rows allows saving
  // links as the affected user; the bookmarklet can be regenerated to
  // invalidate, while the API_DOCS token is auto-provisioned and never shown.
  secretValue String?

  @@index([userId])
  @@index([userId, kind])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model ExtensionAuthCode {
  id            String   @id @default(cuid())
  codeHash      String   @unique
  codeChallenge String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([userId])
}

model Meta {
  id     String @id @default(cuid())
  linkId String @unique
  link   Link   @relation(fields: [linkId], references: [id], onDelete: Cascade)

  description String?
  faviconUrl  String?
  imageUrl    String?
  siteName    String?
  source      String?
  title       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  fetchedAt DateTime?
}

model RssEntry {
  id          String   @id @default(cuid())
  sourceKey   String
  url         String
  title       String
  description String?
  imageUrl    String?
  siteName    String?
  publishedAt DateTime
  fetchedAt   DateTime @default(now())

  @@unique([sourceKey, url])
  @@index([sourceKey, publishedAt(sort: Desc)])
}
