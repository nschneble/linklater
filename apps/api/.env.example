DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME?params"
JWT_SECRET="CHANGEME"

# 2FA encryption keys — generate with: openssl rand -hex 32
# TOTP secrets and phone numbers are AES-256-GCM encrypted at rest.
TOTP_ENCRYPTION_KEY="CHANGEME_32_BYTE_HEX"
PHONE_ENCRYPTION_KEY="CHANGEME_32_BYTE_HEX"

# Twilio Verify (SMS 2FA — optional, required only if SMS 2FA is offered)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# Public URL of the web app (used in email links)
APP_URL="https://localhost:5173"

# SMTP settings for email verification, password reset
# Local dev: Mailpit catches all outgoing mail
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Linklater <noreply@linklater.app>"

# Apple Sign In (optional)
# https://developer.apple.com/account/resources/identifiers/list/serviceId

APPLE_CALLBACK_URL="https://localhost:3000/auth/apple/callback"
APPLE_CLIENT_ID=""    # Services ID (e.g. com.example.linklater.web)
APPLE_KEY_ID=""       # Private key identifier
APPLE_PRIVATE_KEY=""  # Contents of the .p8 private key file
APPLE_TEAM_ID=""      # 10-character Team ID

# Google OAuth (optional)
# https://console.cloud.google.com/apis/credentials

GOOGLE_CALLBACK_URL="https://localhost:3000/auth/google/callback"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
