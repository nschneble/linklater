DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME?params"
JWT_SECRET="CHANGEME"

# Public URL of the web app — used in email links
APP_URL="http://localhost:5173"

# SMTP settings for transactional email (verification, password reset)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="user@example.com"
SMTP_PASS="CHANGEME"
SMTP_FROM="Linklater <noreply@example.com>"
