{
  "action": "view-read-links",
  "steps": [
    { "kind": "navigate", "path": "/unread" },
    {
      "kind": "click",
      "hint": { "role": "tab", "text": "Read" }
    }
  ],
  "expect": {
    "anyOf": [
      { "selector": "[role='tab'][aria-selected='true']:has-text('Read')" }
    ],
    "timeoutMs": 15000
  },
  "mask": [{ "selector": "#suggestion-callout-title" }],
  "diff": { "maxDiffRatio": 0.02 }
}
